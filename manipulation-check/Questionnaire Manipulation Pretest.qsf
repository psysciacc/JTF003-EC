ttribute":null,"Payload":{"QuestionText":"Click to write the question text","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Click to write the question text","Choices":{"1":{"Display":"A"},"2":{"Display":"B"},"3":{"Display":"C"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"Click to write the question text","DataExportTag":"Q919","QuestionID":"QID919"}},{"SurveyID":"SV_8iFeD0xUZQZDDCK","Element":"SQ","PrimaryAttribute":"QID987","SecondaryAttribute":"Click to write the question text","TertiaryAttribute":null,"Payload":{"QuestionText":"Click to write the question text","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Click to write the question text","Choices":{"1":{"Display":"A"},"2":{"Display":"B"},"3":{"Display":"C"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"Click to write the question text","DataExportTag":"Q987","QuestionID":"QID987"}},{"SurveyID":"SV_8iFeD0xUZQZDDCK","Element":"SQ","PrimaryAttribute":"QID1040","SecondaryAttribute":"Click to write the question text","TertiaryAttribute":null,"Payload":{"QuestionText":"Click to write the question text","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Click to write the question text","Choices":{"1":{"Display":"A"},"2":{"Display":"B"},"3":{"Display":"C"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"Click to write the question text","DataExportTag":"Q1040","QuestionID":"QID1040"}},{"SurveyID":"SV_8iFeD0xUZQZDDCK","Element":"SQ","PrimaryAttribute":"QID1103","SecondaryAttribute":"Click to write the question text","TertiaryAttribute":null,"Payload":{"QuestionText":"Click to write the question text","DataExportTag":"Q1103","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Click to write the question text","Choices":{"1":{"Display":"Click to write Choice 1"},"2":{"Display":"Click to write Choice 2"},"3":{"Display":"Click to write Choice 3"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID1103"}},{"SurveyID":"SV_8iFeD0xUZQZDDCK","Element":"SQ","PrimaryAttribute":"QID3","SecondaryAttribute":"Consent \u00a0 1.\u00a0\u00a0 I confirm that I have read and understood the Information Sheet for this study. \u00a0","TertiaryAttribute":null,"Payload":{"ChoiceOrder":[1,2],"Choices":{"1":{"Display":"I consent"},"2":{"Display":"I do not consent"}},"Configuration":{"QuestionDescriptionOption":"UseText"},"DataExportTag":"Consent","DataVisibility":{"Hidden":false,"Private":false},"DefaultChoices":false,"GradingData":[],"Language":[],"NextAnswerId":1,"NextChoiceId":3,"QuestionDescription":"Consent \u00a0 1.\u00a0\u00a0 I confirm that I have read and understood the Information Sheet for this study. \u00a0...","QuestionID":"QID3","QuestionText":"<p><strong>Consent<\/strong><\/p>\n\n<p>&nbsp;<\/p>\n\n<p>1.&nbsp;&nbsp; I confirm that I have read and understood the Information Sheet for this study. <br><\/p>\n\n<p>&nbsp;<\/p>\n\n<p>2.&nbsp;&nbsp; I understand that my participation is voluntary and that I am free to withdraw from the project at any time without giving any reason and without penalty. I understand that any data collected up to the point of my withdrawal cannot be withdrawn because it cannot be identified.<\/p>\n\n<p>&nbsp;<\/p>\n\n<p>3.&nbsp;&nbsp; I understand that the identifiable data provided will be securely stored and accessible only to the members of the research team directly involved in the project, and that confidentiality will be maintained.<\/p>\n\n<p>&nbsp;<\/p>\n\n<p>4.&nbsp;&nbsp; I understand that my fully anonymised data will be used for the purpose of this study.<\/p>\n\n<p>&nbsp;<\/p>\n\n<p>5.&nbsp;&nbsp; I understand that the data collected about me will be used to support other research in the future, and may be shared anonymously with other researchers. <\/p>\n\n<p>&nbsp;<\/p>\n\n<p>6.&nbsp;&nbsp; I give permission for all the anonymised data and transcripts that I provide to be deposited in public repository (e.g., Open Science Framework) so that they will be available for future research and learning activities by other individuals.<\/p>\n\n<p>&nbsp;<\/p>\n\n<p>7.&nbsp;&nbsp; I agree to take part in the above study.<br>\n&nbsp;<\/p>Please select your answer below to indicate whether you consent or not to participate in the study\n\n<p>&nbsp;<\/p>\n\n<p>&nbsp;<\/p>\n\n<p><\/p>","QuestionText_Unsafe":"<p><strong>Consent<\/strong><\/p>\n\n<p>&nbsp;<\/p>\n\n<p>1.&nbsp;&nbsp; I confirm that I have read and understood the Information Sheet for this study. <br><\/p>\n\n<p>&nbsp;<\/p>\n\n<p>2.&nbsp;&nbsp; I understand that my participation is voluntary and that I am free to withdraw from the project at any time without giving any reason and without penalty. I understand that any data collected up to the point of my withdrawal cannot be withdrawn because it cannot be identified.<o:p><\/o:p><\/p>\n\n<p>&nbsp;<\/p>\n\n<p>3.&nbsp;&nbsp; I understand that the identifiable data provided will be securely stored and accessible only to the members of the research team directly involved in the project, and that confidentiality will be maintained.<o:p><\/o:p><\/p>\n\n<p>&nbsp;<\/p>\n\n<p>4.&nbsp;&nbsp; I understand that my fully anonymised data will be used for the purpose of this study.<o:p><\/o:p><\/p>\n\n<p>&nbsp;<\/p>\n\n<p>5.&nbsp;&nbsp; I understand that the data collected about me will be used to support other research in the future, and may be shared anonymously with other researchers. <o:p><\/o:p><\/p>\n\n<p>&nbsp;<\/p>\n\n<p>6.&nbsp;&nbsp; I give permission for all the anonymised data and transcripts that I provide to be deposited in public repository (e.g., Open Science Framework) so that they will be available for future research and learning activities by other individuals.<o:p><\/o:p><\/p>\n\n<p>&nbsp;<\/p>\n\n<p>7.&nbsp;&nbsp; I agree to take part in the above study.<br>\n&nbsp;<\/p>Please select your answer below to indicate whether you consent or not to participate in the study\n\n<p>&nbsp;<\/p>\n\n<p>&nbsp;<\/p>\n\n<p><o:p><\/o:p><\/p>","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}}}},{"SurveyID":"SV_8iFeD0xUZQZDDCK","Element":"SQ","PrimaryAttribute":"QID902","SecondaryAttribute":"Consent \u00a0 1.\u00a0\u00a0 I confirm that I have read and understood the Information Sheet for this study. \u00a0","TertiaryAttribute":null,"Payload":{"ChoiceOrder":[1,2],"Choices":{"1":{"Display":"I consent"},"2":{"Display":"I do not consent"}},"Configuration":{"QuestionDescriptionOption":"UseText"},"DataVisibility":{"Hidden":false,"Private":false},"DefaultChoices":false,"GradingData":[],"Language":[],"NextAnswerId":1,"NextChoiceId":3,"QuestionDescription":"Consent \u00a0 1.\u00a0\u00a0 I confirm that I have read and understood the Information Sheet for this study. \u00a0...","QuestionText":"<p><strong>Consent<\/strong><\/p>\n\n<p>&nbsp;<\/p>\n\n<p>1.&nbsp;&nbsp; I confirm that I have read and understood the Information Sheet for this study. <br><\/p>\n\n<p>&nbsp;<\/p>\n\n<p>2.&nbsp;&nbsp; I understand that my participation is voluntary and that I am free to withdraw from the project at any time without giving any reason and without penalty. I understand that any 
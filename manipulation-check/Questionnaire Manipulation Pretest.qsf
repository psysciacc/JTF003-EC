"5":{"Display":"Neither low nor high mental effort"},"6":{"Display":"Rather high mental effort"},"7":{"Display":"High mental effort"},"8":{"Display":"Very high mental effort"},"9":{"Display":"Very, very high mental effort"}},"ChoiceOrder":["1","2","3","4","5","6","7","8","9"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":10,"NextAnswerId":1,"QuestionID":"QID1109"}},{"SurveyID":"SV_8iFeD0xUZQZDDCK","Element":"SQ","PrimaryAttribute":"QID1110","SecondaryAttribute":"How much mental effort did you invest in solving the reasoning problems in this study?","TertiaryAttribute":null,"Payload":{"QuestionText":"How much mental effort did you invest in solving the reasoning problems in this study?","DataExportTag":"IJ_mental_effort","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"How much mental effort did you invest in solving the reasoning problems in this study?","Choices":{"1":{"Display":"Very, very low mental effort"},"2":{"Display":"Very low mental effort"},"3":{"Display":"Low mental effort"},"4":{"Display":"Rather low mental effort"},"5":{"Display":"Neither low nor high mental effort"},"6":{"Display":"Rather high mental effort"},"7":{"Display":"High mental effort"},"8":{"Display":"Very high mental effort"},"9":{"Display":"Very, very high mental effort"}},"ChoiceOrder":["1","2","3","4","5","6","7","8","9"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":10,"NextAnswerId":1,"QuestionID":"QID1110"}},{"SurveyID":"SV_8iFeD0xUZQZDDCK","Element":"SQ","PrimaryAttribute":"QID614","SecondaryAttribute":"How well do the following statements describe you?","TertiaryAttribute":null,"Payload":{"QuestionText":"How well do the following statements describe you?","DefaultChoices":false,"DataExportTag":"IH","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidth":25,"MobileFirst":false,"ChoiceColumnWidthPixels":311,"RepeatHeaders":"none","WhiteSpace":"OFF"},"QuestionDescription":"How well do the following statements describe you?","Choices":{"1":{"Display":"I am willing to admit it if I don\u2019t know something"},"49":{"Display":"I like to compliment others on their intellectual strengths"},"50":{"Display":"I try to reflect on my weaknesses in order to develop my intelligence"},"51":{"Display":"I actively seek feedback on my ideas, even if it is critical"},"52":{"Display":"I acknowledge when someone knows more than me about a certain subject"},"53":{"Display":"If someone doesn\u2019t understand my idea, it\u2019s probably because they aren\u2019t smart enough to get it"},"54":{"Display":"I sometimes marvel at the intellectual abilities of other people"},"55":{"Display":"I feel uncomfortable when someone points out one of my intellectual shortcomings"},"57":{"Display":"I don\u2019t like it when someone points out an intellectual mistake that I made"}},"ChoiceOrder":["1","49","50","51","52","53","54","55","57"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":58,"NextAnswerId":7,"Answers":{"1":{"Display":"1<br \/>\nNot at all like me"},"6":{"Display":"2<br \/>\n&nbsp;"},"2":{"Display":"3<br \/>\n&nbsp;"},"3":{"Display":"4<br \/>\n&nbsp;"},"4":{"Display":"5<br \/>\nVery much like me"}},"AnswerOrder":["1","6","2","3","4"],"ChoiceDataExportTags":{"1":"IH_1","49":"IH_2","50":"IH_3","51":"IH_4","52":"IH_5","53":"IH_6","54":"IH_7","55":"IH_8","57":"IH_9"},"QuestionID":"QID614","Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"},"DataVisibility":{"Private":false,"Hidden":false},"RecodeValues":{"1":"1","2":"3","3":"4","4":"5","6":"2"}}},{"SurveyID":"SV_8iFeD0xUZQZDDCK","Element":"SQ","PrimaryAttribute":"QID822","SecondaryAttribute":"How well do the following statements describe you?","TertiaryAttribute":null,"Payload":{"QuestionText":"How well do the following statements describe you?","DefaultChoices":false,"DataExportTag":"OMT","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidth":25,"ChoiceColumnWidthPixels":311,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":false},"QuestionDescription":"How well do the following statements describe you?","Choices":{"1":{"Display":"People should always take into consideration evidence that goes against their opinions."},"58":{"Display":"Changing your mind is a sign of weakness."},"59":{"Display":"I like to think that my actions are motivated by sound reasons."},"60":{"Display":"It is important to stick to your opinions even when evidence is brought to bear against them."},"61":{"Display":"Intuition is the best guide in making decisions."},"62":{"Display":"Considering too many different opinions often leads to muddled thinking."},"63":{"Display":"One should disregard evidence that conflicts with your current opinions."},"64":{"Display":"Coming to decisions quickly is a sign of wisdom."},"65":{"Display":"Allowing oneself to be convinced by a solid opposing argument is a sign of good character."},"66":{"Display":"If something I think feels right then I am comfortable, whether or not it is true."},"67":{"Display":"A person should always consider new information."},"68":{"Display":"People should revise their conclusions in response to relevant new information."},"69":{"Display":"Certain opinions are just too important to abandon no matter how good a case can be made against them."}},"ChoiceOrder":["1","58","59","60","61","62","63","64","65","66","67","68","69"],"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"RecodeValues":{"1":"1","2":"3","3":"4","4":"5","6":"2"},"GradingData":[],"Language":[],"NextChoiceId":71,"NextAnswerId":7,"Answers":{"1":{"Display":"1<br \/>\nNot at all like me"},"6":{"Display":"2<br \/>\n&nbsp;"},"2":{"Display":"3<br \/>\n&nbsp;"},"3":{"Display":"4<br \/>\n&nbsp;"},"4":{"Display":"5<br \/>\nVery much like me"}},"AnswerOrder":["1","6","2","3","4"],"ChoiceDataExportTags":{"1":"OMT_1","58":"OMT_2","59":"OMT_3","60":"OMT_4","61":"OMT_5","62":"OMT_6","63":"OMT_7","64":"OMT_8","65":"OMT_9","66":"OMT_10","67":"OMT_11","68":"OMT_12","69":"OMT_13"},"QuestionID":"QID822"}},{"SurveyID":"SV_8iFeD0xUZQZDDCK","Element":"SQ","PrimaryAttribute":"QID823","SecondaryAttribute":"How well do the following statements describe you?","TertiaryAttribute":null,"Payload":{"QuestionText":"How well do the following statements describe you?","DefaultChoices":false,"DataExportTag":"IC","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidth":25,"ChoiceColumnWidthPixels":311,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":false},"QuestionDescription":"How well do the following statements describe you?","Choices":{"1":{"Display":"I'd rather depend on myself than others."},"71":{"Display":"I rely on myself most of the time; I rarely rely on others."},"72":{"Display":"I often do \"my own thing.\""},"73":{"Display":"My personal identity, independent of others, is very important to me."},"74":{"Display":" It is important that I do my job better than others."},"75":{"Display":"Winning is everything."},"76":{"Display":"Competition is the law of nature."},"77":{"Display":"When another person does better than I do, I get tense and aroused."},"78":{"Display":"If a coworker gets a prize, I would feel proud."},"79":{"Display":"The well-being of my coworkers is important to me."},"80":{"Display":"I feel good when I cooperate with others."},"81":{"Display":"Parents and children must stay together as much as possible."},"82":{"Display":"It is my duty to take care of my family, even when I have to sacrifice what I want."},"83":{"Display":"It is important to me that I respect the decisions made by my groups."},"84":{"Display":"To me, pleasure is spending time with others."},"85":{"Display":"Family members should stick together, no matter what sacrifices are required."}},"ChoiceOrder":["1","71","72","73","74","75","76","77","78","79","84","80","81","82","85","83"],"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"RecodeValues":{"1":"1","2":"3","3":"4","4":"5","6":"2"},"GradingData":[],"Language":[],"NextChoiceId":86,"NextAnswerId":7,"Answers":{"1":{"Display":"1<br \/>\nNot at all like me"},"6":{"Display":"2<br \/>\n&nbsp;"},"2":{"Display":"3<br \/>\n&nbsp;"},"3":{"Display":"4<br \/>\n&nbsp;"},"4":{"Display":"5<br \/>\nVery much like me"}},"AnswerOrder":["1","6","2","3","4"],"ChoiceDataExportTags":{"1":"H_I_1","71":"H_I_2","72":"H_I_3","73":"H_I_4","74":"V_I_1","75":"V_I_2","76":"V_I_3","77":"V_I_4","78":"H_C_1","79":"H_C_2","80":"H_C_4","81":"V_C_1","82":"V_C_2","83":"V_C_4","84":"H_C_3","85":"V_C_3"},"QuestionID":"QID823"}},{"SurveyID":"SV_8iFeD0xUZQZDDCK","Element":"SQ","PrimaryAttribute":"QID1018","SecondaryAttribute":"If yes, please specify which external resource did you use?","TertiaryAttribute":null,"Payload":{"QuestionText":"If yes, please specify which external resource did you use?","DefaultChoices":false,"QuestionType":"TE","Selector":"SL","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"If yes, please specify which external resource did you use?","Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"DisplayLogic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID1017\/SelectableChoice\/1","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">\r\n\nHave you ever encountered this or very similar problems before starting our study?\r\n<\/span> <span class=\"LeftOpDesc\">Yes<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID1017\/SelectableChoice\/1","LogicType":"Question","Operator":"Selected","QuestionID":"QID1017","QuestionIDFromLocator":"QID1017","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression","inPage":false},"DataVisibility":{"Private":false,"Hidden":false},"QuestionText_Unsafe":"If yes, please specify which external resource did you use?","DataExportTag":"Q1018","QuestionID":"QID1018"}},{"SurveyID":"SV_8iFeD0xUZQZDDCK","Element":"SQ","PrimaryAttribute":"QID472","SecondaryAttribute":"In addition, we will ask you to complete another task: a counting task. \u00a0 In this simple task, yo..","TertiaryAttribute":null,"Payload":{"QuestionText":"<div>In addition, we will ask you to complete another task: <strong>a counting task.<\/strong><\/div>\n\n<div>&nbsp;<\/div>\n\n<div>In this simple task, you will be shown a table with ten columns and ten rows (i.e., 100 cells), each cell containing a letter &quot;A&quot; or &quot;H&quot;. You will be asked to count how many letter &quot;As&quot; there are.<\/div>\n\n<div>&nbsp;<\/div>\n\n<div>You can see an example on the next page.<\/div>","DefaultChoices":false,"DataExportTag":"Q472","QuestionID":"QID472","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"In addition, we will ask you to complete another task: a counting task. \u00a0 In this simple task, yo...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_8iFeD0xUZQZDDCK","Element":"SQ","PrimaryAttribute":"QID467","SecondaryAttribute":"In the actual study you will also be presented with a memorisation task. You will briefly see a m...","TertiaryAttribute":null,"Payload":{"QuestionText":"In the actual study you will also be presented with a memorisation task. You will briefly see a matrix with crosses, and you must memorise where they were located.<br><br>We will let you practice the memorisation task now.<br><br>You will first get to see the pattern for 2 seconds. After that, you will have to choose the correct pattern from 4 different options.<br><br>Click \"Next\" button if you are ready to start.<br>","DefaultChoices":false,"DataExportTag":"wm_instructions","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"In the actual study you will also be presented with a memorisation task. You will briefly see a m...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID467"}},{"SurveyID":"SV_8iFeD0xUZQZDDCK","Element":"SQ","PrimaryAttribute":"QID33","SecondaryAttribute":"In the actual study you will also be presented with a memorization task. You will briefly see a m...","TertiaryAttribute":null,"Payload":{"ChoiceOrder":[],"Configuration":{"QuestionDescriptionOption":"UseText"},"DataExportTag":"Q117","DefaultChoices":false,"GradingData":[],"Language":[],"QuestionDescription":"In the actual study you will also be presented with a memorization task. You will briefly see a m...","QuestionID":"QID33","QuestionText":"In the actual study you will also be presented with a memorization task. You will briefly see a matrix with crosses, and you must memorize where they were located.<br \/>\n<br \/>\nWe will let you practice the memorization task now.<br \/>\n<br \/>\nYou will first get to see the pattern for 2 seconds. After that, you will have to choose the correct pattern from 4 different options.<br \/>\n<br \/>\nWhen you have made a decision simply click &quot;Next&quot; and you will get the next problem.<br \/>\n<br \/>\nClick &quot;Next&quot; to continue.","QuestionText_Unsafe":"In the actual study you will also be presented with a memorization task. You will briefly see a matrix with crosses, and you must memorize where they were located.<br \/>\n<br \/>\nWe will let you practice the memorization task now.<br \/>\n<br \/>\nYou will first get to see the pattern for 2 seconds. After that, you will have to choose the correct pattern from 4 different options.<br \/>\n<br \/>\nWhen you have made a decision simply click &quot;Next&quot; and you will get the next problem.<br \/>\n<br \/>\nClick &quot;Next&quot; to continue.","QuestionType":"DB","Selector":"TB","Validation":{"Settings":{"Type":"None"}}}},{"SurveyID":"SV_8iFeD0xUZQZDDCK","Element":"SQ","PrimaryAttribute":"QID841","SecondaryAttribute":"In the actual study you will need to memorise the pattern while you solve the reasoning problem....","TertiaryAttribute":null,"Payload":{"QuestionText":"In the actual study you will need to memorise the pattern while you solve the reasoning problem. The pattern is briefly presented before each problem.<br>\n<br>\nThe difficulty of the pattern might vary. Always try to to memorise as many crosses as possible. Each cross counts!<br>\n<br>\nWe know that it is not always easy to memorise the pattern while you are also thinking about the reasoning problem. The most important thing is to correctly memorise the pattern.<br>\n<br>\nFirst, try to concentrate on the memorisation task, and then try to solve the reasoning task.<br>\n<br>\nAs a next step, you can practice this with two reasoning problems.","DefaultChoices":false,"DataExportTag":"Q841","QuestionID":"QID841","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"In the actual study you will need to memorise the pattern while you solve the reasoning problem....","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_8iFeD0xUZQZDDCK","Element":"SQ","PrimaryAttribute":"QID41","SecondaryAttribute":"In the actual study you will need to memorize the pattern while you solve the reasoning problem....","TertiaryAttribute":null,"Payload":{"ChoiceOrder":[],"Configuration":{"QuestionDescriptionOption":"UseText"},"DataExportTag":"Q321","DefaultChoices":false,"GradingData":[],"Language":[],"QuestionDescription":"In the actual study you will need to memorize the pattern while you solve the reasoning problem....","QuestionID":"QID41","QuestionText":"In the actual study you will need to memorize the pattern while you solve the reasoning problem. The pattern is briefly presented before each problem.<br \/>\n<br \/>\nThe difficulty of the pattern might vary. Always try to to memorize as many crosses as possible. Each cross counts!<br \/>\n<br \/>\nWe know that it is not always easy to memorize the pattern while you are also thinking about the reasoning problem. The most important thing is to correctly memorize the pattern.<br \/>\n<br \/>\nFirst, try to concentrate on the memorization task, and then try to solve the reasoning task.<br \/>\n<br \/>\nAs a next step, you can practice this with two reasoning problems.","QuestionText_Unsafe":"In the actual study you will need to memorize the pattern while you solve the reasoning problem. The pattern is briefly presented before each problem.<br \/>\n<br \/>\nThe difficulty of the pattern might vary. Always try to to memorize as many crosses as possible. Each cross counts!<br \/>\n<br \/>\nWe know that it is not always easy to memorize the pattern while you are also thinking about the reasoning problem. The most important thing is to correctly memorize the pattern.<br \/>\n<br \/>\nFirst, try to concentrate on the memorization task, and then try to solve the reasoning task.<br \/>\n<br \/>\nAs a next step, you can practice this with two reasoning problems.","QuestionType":"DB","Selector":"TB","Validation":{"Settings":{"Type":"None"}}}},{"SurveyID":"SV_8iFeD0xUZQZDDCK","Element":"SQ","PrimaryAttribute":"QID403","SecondaryAttribute":"In the actual study you will need to memorize the pattern while you solve the reasoning problem....","TertiaryAttribute":null,"Payload":{"QuestionText":"In the actual study you will need to memorize the pattern while you solve the reasoning problem. The pattern is briefly presented before each problem.<br \/>\n<br \/>\nThe difficulty of the pattern might vary. Always try to to memorize as many crosses as possible. Each cross counts!<br \/>\n<br \/>\nWe know that it is not always easy to memorize the pattern while you are also thinking about the reasoning problem. The most important thing is to correctly memorize the pattern.<br \/>\n<br \/>\nFirst, try to concentrate on the memorization task, and then try to solve the reasoning task.<br \/>\n<br \/>\nAs a next step, you can practice this with two reasoning problems.","DefaultChoices":false,"DataExportTag":"Q321","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"In the actual study you will need to memorize the pattern while you solve the reasoning problem....","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"QuestionText_Unsafe":"In the actual study you will need to memorize the pattern while you solve the reasoning problem. The pattern is briefly presented before each problem.<br \/>\n<br \/>\nThe difficulty of the pattern might vary. Always try to to memorize as many crosses as possible. Each cross counts!<br \/>\n<br \/>\nWe know that it is not always easy to memorize the pattern while you are also thinking about the reasoning problem. The most important thing is to correctly memorize the pattern.<br \/>\n<br \/>\nFirst, try to concentrate on the memorization task, and then try to solve the reasoning task.<br \/>\n<br \/>\nAs a next step, you can practice this with two reasoning problems.","QuestionID":"QID403"}},{"SurveyID":"SV_8iFeD0xUZQZDDCK","Element":"SQ","PrimaryAttribute":"QID446","SecondaryAttribute":"In the next section, we will ask you to solve the same eight word problems again. \u00a0 This time, we..","TertiaryAttribute":null,"Payload":{"ChoiceOrder":[],"Configuration":{"QuestionDescriptionOption":"UseText"},"DataExportTag":"ENC_phase2","DataVisibility":{"Hidden":false,"Private":false},"DefaultChoices":false,"GradingData":[],"Language":[],"NextAnswerId":1,"NextChoiceId":1,"QuestionDescription":"In the next section, we will ask you to solve the same eight word problems again. \u00a0 This time, we...","QuestionID":"QID446","QuestionText":"<p>In the next section, we will ask you <strong>to solve the same eight word problems again<\/strong>.<br>\n&nbsp;<\/p>\n\n<p>This time, <strong>we will give you feedback on your previous answer<\/strong>: we will tell you whether your answer was correct or not and <em>explain<\/em> why this is the case. You will have the opportunity to provide a new answer to the same problem, so if you initially made an incorrect answer then you can change your initial answer.<\/p><p><br><\/p><p>Before we start, we are going to ask you to complete a word categorisation task on the next page.<\/p>","QuestionText_Unsafe":"<p>In the next section, we will ask you <strong>to solve the same eight word problems again<\/strong>.<br>\n&nbsp;<\/p>\n\n<p>This time, <strong>we will give you feedback on your previous answer<\/strong>: we will tell you whether your answer was correct or not and <em>explain<\/em> why this is the case. You will have the opportunity to provide a new answer to the same problem, so if you initially made an incorrect answer then you can change your initial answer.<\/p><p><br><\/p><p>Before we start, we are going to ask you to complete a word categorisation task on the next page.<\/p>","QuestionType":"DB","Selector":"TB","Validation":{"Settings":{"Type":"None"}}}},{"SurveyID":"SV_8iFeD0xUZQZDDCK","Element":"SQ","PrimaryAttribute":"QID443","SecondaryAttribute":"In the next section, we will ask you to solve the same eight word problems again. \u00a0 This time,\u00a0we.","TertiaryAttribute":null,"Payload":{"ChoiceOrder":[],"Configuration":{"QuestionDescriptionOption":"UseText"},"DataExportTag":"ECB_phase2","DataVisibility":{"Hidden":false,"Private":false},"DefaultChoices":false,"GradingData":[],"Language":[],"NextAnswerId":1,"NextChoiceId":1,"QuestionDescription":"In the next section, we will ask you to solve the same eight word problems again. \u00a0 This time,\u00a0we...","QuestionID":"QID443","QuestionText":"<p>In the next section, we will ask you<strong> to solve the same eight word problems again<\/strong>.<br>\n&nbsp;<\/p>\n\n<p>This time,&nbsp;<strong>we will give you feedback on your previous answer<\/strong>: we will tell you whether your answer was correct or not and&nbsp;<em>explain<\/em>&nbsp;why this is the case. You will have the opportunity to provide a new answer to the same problem, so if you initially made an incorrect answer then you can change your initial answer.<\/p>\n\n<p>&nbsp;<\/p>\n\n<p><strong>However, if you decide to change your original answer you will then&nbsp;<u>have&nbsp;to complete a word categorisation task<\/u>&nbsp;each time you decide to change your original answer. This will cost you extra time and effort.<br><\/strong><\/p>\n\n<p>&nbsp;<\/p>\n\n<p><u><strong>You will get extra \u00a30.20 for correcting your originally incorrect response (i.e., as a bonus payment).<\/strong><\/u><\/p>\n\n<p>&nbsp;<\/p>\n\n<p>Before we start, we are going to ask you to complete an example of the word categorisation task on the next page.<\/p>","QuestionText_Unsafe":"<p>In the next section, we will ask you<strong> to solve the same eight word problems again<\/strong>.<br>\n&nbsp;<\/p>\n\n<p>This time,&nbsp;<strong>we will give you feedback on your previous answer<\/strong>: we will tell you whether your answer was correct or not and&nbsp;<em>explain<\/em>&nbsp;why this is the case. You will have the opportunity to provide a new answer to the same problem, so if you initially made an incorrect answer then you can change your initial answer.<\/p>\n\n<p>&nbsp;<\/p>\n\n<p><strong>However, if you decide to change your original answer you will then&nbsp;<u>have&nbsp;to complete a word categorisation task<\/u>&nbsp;each time you decide to change your original answer. This will cost you extra time and effort.<br><\/strong><\/p>\n\n<p>&nbsp;<\/p>\n\n<p><u><strong>You will get extra \u00a30.20 for correcting your originally incorrect response (i.e., as a bonus payment).<\/strong><\/u><\/p>\n\n<p>&nbsp;<\/p>\n\n<p>Before we start, we are going to ask you to complete an example of the word categorisation task on the next page.<\/p>","QuestionType":"DB","Selector":"TB","Validation":{"Settings":{"Type":"None"}}}},{"SurveyID":"SV_8iFeD0xUZQZDDCK","Element":"SQ","PrimaryAttribute":"QID2","SecondaryAttribute":"Information sheet The study The aim of this study is to investigate how people solve word problem...","TertiaryAttribute":null,"Payload":{"ChoiceOrder":[],"Configuration":{"QuestionDescriptionOption":"UseText"},"DataExportTag":"InfoSheet","DataVisibility":{"Hidden":false,"Private":false},"DefaultChoices":false,"GradingData":[],"Language":[],"NextAnswerId":1,"NextChoiceId":6,"QuestionDescription":"Information sheet The study The aim of this study is to investigate how people solve word problem...","QuestionID":"QID2","QuestionText":"<p><strong>Information sheet<\/strong><br>\n<br>\n<strong>The study<\/strong><br>\nThe aim of this study is to investigate how people solve word problems. You will be asked to solve word problems and provide basic information about yourself.&nbsp;This online study consists of one session, lasting around 10 minutes and is paid \u00a31.00.<br>\n<br>\n<strong>Potential risks<\/strong><br>\nThere are no known risks attached to participating in this experiment.<br>\n<br>\n<strong>Informed consent<\/strong><br>\nShould you agree to take part in this experiment, you will be asked to confirm your informed consent before the experiment commences.<br>\n<br>\n<strong>Withdrawal<\/strong><br>\nYour participation is voluntary, and you will be free to withdraw from the project at any time without giving any reason and without penalty. If you wish to withdraw, you simply need to close the browser with the questionnaire. It will not be possible to withdraw from the study after you have completed it because we will not be able to identify your data.<br>\n<br>\n<strong>Data gathered<\/strong><br>\nYour experimental data will be fully anonymous, so that it is not possible to identify you from our stored data. Your data will be gathered by Prof Miroslav Sirota.&nbsp;Your anonymous data may be published in scientific journal articles, and shared in permanent, publicly accessible archives accessible from any country.<\/p>\n<br>\n<strong>Ethical approval<\/strong><br>\nThis project has been reviewed on behalf of the University of Essex Ethics Committee and had been given approval.<br>\n&nbsp;\n<p><strong>Concerns and complaints<\/strong><br>\nIf you have any concerns about any aspect of the study or you have a complaint, in the first instance please contact the Principal Investigator of the project (see contact details below). If you are still concerned or you think your complaint has not been addressed to your satisfaction, please contact the Director of Research in the Principal Investigator\u2019s department (see below). If you are still not satisfied, please contact the <span style=\"line-height:115%\"><span style=\"line-height:115%\">University\u2019s Research Integrity Manager (see below)<\/span><\/span>.<br>\n<br>\n<strong>Contact details<br><br><\/strong><\/p>\n\n<p><strong>Principal Investigator<\/strong><\/p>\n\n<p>Prof Miroslav Sirota<br>\nEmail: msirota@essex.ac.uk<br><br><\/p>\n\n<p><span style=\"line-height:115%\"><strong><span style=\"line-height:115%\">Director of Research, Dept of Psychology<\/span><\/strong><br>\n<span style=\"line-height:115%\">Prof Sheina Orbell (<\/span><a style=\"color:blue; text-decoration:underline\" href=\"mailto:sorbell@essex.ac.uk\"><span style=\"line-height:115%\">sorbell@essex.ac.uk<\/span><\/a><span style=\"line-height:115%\"> )<br>\n<br>\n<b>University of Essex Research Integrity Manager<\/b><\/span><\/span><br>\n<span style=\"line-height:115%\"><span style=\"line-height:115%\">Mantalena Sotiriadou, Research &amp; Enterprise Office, University of Essex, Wivenhoe Park, CO4 3SQ, Colchester. <\/span><\/span><\/p>\n\n<p>&nbsp;<\/p>","QuestionText_Unsafe":"<p><strong>Information sheet<br>\n<br>\nInvitation to our study<\/strong><br>\nWe would like to invite you to participate in this research project. You should only participate if you want to; choosing not to take part will not disadvantage you in any way. Before you decide whether you want to take part, it is important for you to read the following information carefully and discuss it with others if you wish.&nbsp;<br>\n<br>\n<strong>The study<\/strong><o:p><\/o:p><br>\nThe aim of this study is to investigate how people solve verbal problems. You will be asked to solve verbal problems, categorisation tasks, answer a hypothetical situation and provide basic information about yourself.&nbsp;This online study consists of one session, lasting around 15 minutes and is paid \u00a31.3. <o:p><\/o:p><br>\n<br>\n<strong>Potential risks<\/strong> <o:p><\/o:p><br>\nThere are no known risks attached to participating in this experiment.<br>\n<br>\n<strong>Informed consent<\/strong><o:p><\/o:p><br>\nShould you agree to take part in this experiment, you will be asked to confirm your informed consent before the experiment commences.<br>\n<br>\n<strong>Withdrawal<\/strong><o:p><\/o:p><br>\nYour participation is voluntary, and you will be free to withdraw from the project at any time without giving any reason and without penalty. If you wish to withdraw, you simply need to close the browser with the questionnaire. It will not be possible to withdraw from the study after you have completed it because we will not be able to identify your data.<br>\n<br>\n<strong>Data gathered<\/strong><br>\nWe will collect the following data from each participant: your answers to verbal problems, categorisation tasks and basic socio-demographic information such as gender and age.&nbsp;Your experimental data will be fully anonymous, so that it is not possible to identify you from our stored data.<o:p><\/o:p> Your data will be gathered by Dr Miroslav Sirota.&nbsp;<o:p><\/o:p>Your anonymous data may be published in scientific journal articles, and shared in permanent, publicly accessible archives accessible from any country.<\/p>\n<br>\n<strong>Ethical approval<\/strong><br>\nThis project has been reviewed on behalf of the University of Essex Ethics Committee and had been given approval.<br>\n<br>\n<strong>Concerns and complaints<\/strong><br>\nIf you have any concerns about any aspect of the study or you have a complaint, in the first instance please contact the Principal Investigator of the project (see contact details below). If you are still concerned or you think your complaint has not been addressed to your satisfaction, please contact the Director of Research in the Principal Investigator\u2019s department (see below). If you are still not satisfied, please contact the University\u2019s Research Governance and Planning Manager (Sarah Manning-Press).\n<p><br>\n<strong>Contact details<\/strong><\/p>\n\n<p><strong>Principal Investigator<\/strong><br>\nDr Miroslav Sirota<br>\nEmail: msirota@essex.ac.uk<br>\n<br>\n<strong>Director of Research, Dept of Psychology<\/strong><o:p><\/o:p><br>\nProf Silke Paulmann (paulmann@essex.ac.uk)<o:p><\/o:p><br>\n<br>\n<strong>University of Essex Research Governance and Planning Manager<\/strong><o:p><\/o:p><br>\nSarah Manning-Press, Research &amp; Enterprise Office, University of Essex, Wivenhoe Park, CO4 3SQ,<o:p><\/o:p>&nbsp;Colchester. Email: sarahm@essex.ac.uk. Phone: 01206-873561<o:p><\/o:p><\/p>","QuestionType":"DB","Selector":"TB","Validation":{"Settings":{"Type":"None"}}}},{"SurveyID":"SV_8iFeD0xUZQZDDCK","Element":"SQ","PrimaryAttribute":"QID901","SecondaryAttribute":"Information sheet The study The aim of this study is to investigate how people solve word problem...","TertiaryAttribute":null,"Payload":{"ChoiceOrder":[],"Configuration":{"QuestionDescriptionOption":"UseText"},"DataVisibility":{"Hidden":false,"Private":false},"DefaultChoices":false,"GradingData":[],"Language":[],"NextAnswerId":1,"NextChoiceId":6,"QuestionDescription":"Information sheet The study The aim of this study is to investigate how people solve word problem...","QuestionText":"<p><strong>Information sheet<\/strong><br>\n<br>\n<strong>The study<\/strong><br>\nThe aim of this study is to investigate how people solve word problems. You will be asked to solve word problems, counting tasks, answer a few questions and provide basic information about yourself.&nbsp;This online study consists of one session, lasting around 10 minutes and is paid \u00a31.00.<br>\n<br>\n<strong>Potential risks<\/strong><br>\nThere are no known risks attached to participating in this experiment.<br>\n<br>\n<strong>Informed consent<\/strong><br>\nShould you agree to take part in this experiment, you will be asked to confirm your informed consent before the experiment commences.<br>\n<br>\n<strong>Withdrawal<\/strong><br>\nYour participation is voluntary, and you will be free to withdraw from the project at any time without giving any reason and without penalty. If you wish to withdraw, you simply need to close the browser with the questionnaire. It will not be possible to withdraw from the study after you have completed it because we will not be able to identify your data.<br>\n<br>\n<strong>Data gathered<\/strong><br>\nYour experimental data will be fully anonymous, so that it is not possible to identify you from our stored data. Your data will be gathered by Dr Miroslav Sirota.&nbsp;Your anonymous data may be published in scientific journal articles, and shared in permanent, publicly accessible archives accessible from any country.<\/p>\n<br>\n<strong>Ethical approval<\/strong><br>\nThis project has been reviewed on behalf of the University of Essex Ethics Committee and had been given approval.<br>\n<br>\n<strong>Concerns and complaints<\/strong><br>\nIf you have any concerns about any aspect of the study or you have a complaint, in the first instance please contact the Principal Investigator of the project (see contact details below). If you are still concerned or you think your complaint has not been addressed to your satisfaction, please contact the Director of Research in the Principal Investigator\u2019s department (see below). If you are still not satisfied, please contact the University\u2019s Research Governance and Planning Manager (Sarah Manning-Press).\n<p><br>\n<strong>Contact details<\/strong><\/p>\n\n<p><strong>Principal Investigator<\/strong><br>\nDr Miroslav Sirota<br>\nEmail: msirota@essex.ac.uk<br>\n<br>\n<strong>Director of Research, Dept of Psychology<\/strong><br>\nProf Sheina Orbell (sorbell@essex.ac.uk)<br>\n<br>\n<strong>University of Essex Research Governance and Planning Manager<\/strong><br>\nSarah Manning-Press, Research &amp; Enterprise Office, University of Essex, Wivenhoe Park, CO4 3SQ,&nbsp;Colchester. Email: sarahm@essex.ac.uk. Phone: 01206-873561<\/p>","QuestionText_Unsafe":"<p><strong>Information sheet<\/strong><br>\n<br>\n<strong>The study<\/strong><br>\nThe aim of this study is to investigate how people solve word problems. You will be asked to solve word problems, counting tasks, answer a few questions and provide basic information about yourself.&nbsp;This online study consists of one session, lasting around 10 minutes and is paid \u00a31.00.<br>\n<br>\n<strong>Potential risks<\/strong><br>\nThere are no known risks attached to participating in this experiment.<br>\n<br>\n<strong>Informed consent<\/strong><br>\nShould you agree to take part in this experiment, you will be asked to confirm your informed consent before the experiment commences.<br>\n<br>\n<strong>Withdrawal<\/strong><br>\nYour participation is voluntary, and you will be free to withdraw from the project at any time without giving any reason and without penalty. If you wish to withdraw, you simply need to close the browser with the questionnaire. It will not be possible to withdraw from the study after you have completed it because we will not be able to identify your data.<br>\n<br>\n<strong>Data gathered<\/strong><br>\nYour experimental data will be fully anonymous, so that it is not possible to identify you from our stored data. Your data will be gathered by Dr Miroslav Sirota.&nbsp;Your anonymous data may be published in scientific journal articles, and shared in permanent, publicly accessible archives accessible from any country.<\/p>\n<br>\n<strong>Ethical approval<\/strong><br>\nThis project has been reviewed on behalf of the University of Essex Ethics Committee and had been given approval.<br>\n<br>\n<strong>Concerns and complaints<\/strong><br>\nIf you have any concerns about any aspect of the study or you have a complaint, in the first instance please contact the Principal Investigator of the project (see contact details below). If you are still concerned or you think your complaint has not been addressed to your satisfaction, please contact the Director of Research in the Principal Investigator\u2019s department (see below). If you are still not satisfied, please contact the University\u2019s Research Governance and Planning Manager (Sarah Manning-Press).\n<p><br>\n<strong>Contact details<\/strong><\/p>\n\n<p><strong>Principal Investigator<\/strong><br>\nDr Miroslav Sirota<br>\nEmail: msirota@essex.ac.uk<br>\n<br>\n<strong>Director of Research, Dept of Psychology<\/strong><br>\nProf Sheina Orbell (sorbell@essex.ac.uk)<br>\n<br>\n<strong>University of Essex Research Governance and Planning Manager<\/strong><br>\nSarah Manning-Press, Research &amp; Enterprise Office, University of Essex, Wivenhoe Park, CO4 3SQ,&nbsp;Colchester. Email: sarahm@essex.ac.uk. Phone: 01206-873561<\/p>","QuestionType":"DB","Selector":"TB","Validation":{"Settings":{"Type":"None"}},"DataExportTag":"Q901","QuestionID":"QID901"}},{"SurveyID":"SV_8iFeD0xUZQZDDCK","Element":"SQ","PrimaryAttribute":"QID477","SecondaryAttribute":"Let's start with a practice example. Click \"Next\" when ready!","TertiaryAttribute":null,"Payload":{"QuestionText":"<div>Let's start with a practice example.<br><\/div><div><br><\/div><div>Click \"Next\" when ready!<br><\/div>","DefaultChoices":false,"DataExportTag":"practice_CG_notice","QuestionID":"QID477","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Let's start with a practice example. Click \"Next\" when ready!","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":7,"NextAnswerId":1}},{"SurveyID":"SV_8iFeD0xUZQZDDCK","Element":"SQ","PrimaryAttribute":"QID904","SecondaryAttribute":"Let's start with a practice example. Click \"Next\" when ready!","TertiaryAttribute":null,"Payload":{"QuestionText":"<div>Let's start with a practice example.<br><\/div><div><br><\/div><div>Click \"Next\" when ready!<br><\/div>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Let's start with a practice example. Click \"Next\" when ready!","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":7,"NextAnswerId":1,"QuestionText_Unsafe":"<div>Let's start with a practice example.<br><\/div><div><br><\/div><div>Click \"Next\" when ready!<br><\/div>","DataExportTag":"practice_BJ_notice","QuestionID":"QID904"}},{"SurveyID":"SV_8iFeD0xUZQZDDCK","Element":"SQ","PrimaryAttribute":"QID967","SecondaryAttribute":"Let's start with a practice example. Click \"Next\" when ready!","TertiaryAttribute":null,"Payload":{"QuestionText":"<div>Let's start with a practice example.<br><\/div><div><br><\/div><div>Click \"Next\" when ready!<br><\/div>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Let's start with a practice example. Click \"Next\" when ready!","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":7,"NextAnswerId":1,"QuestionText_Unsafe":"<div>Let's start with a practice example.<br><\/div><div><br><\/div><div>Click \"Next\" when ready!<br><\/div>","DataExportTag":"practice_IJ_notice","QuestionID":"QID967"}},{"SurveyID":"SV_8iFeD0xUZQZDDCK","Element":"SQ","PrimaryAttribute":"QID1020","SecondaryAttribute":"Let's start with a practice example. Click \"Next\" when ready!","TertiaryAttribute":null,"Payload":{"QuestionText":"<div>Let's start with a practice example.<br><\/div><div><br><\/div><div>Click \"Next\" when ready!<br><\/div>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Let's start with a practice example. Click \"Next\" when ready!","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":7,"NextAnswerId":1,"QuestionText_Unsafe":"<div>Let's start with a practice example.<br><\/div><div><br><\/div><div>Click \"Next\" when ready!<br><\/div>","DataExportTag":"practice_IJ_notice","QuestionID":"QID1020"}},{"SurveyID":"SV_8iFeD0xUZQZDDCK","Element":"SQ","PrimaryAttribute":"QID12","SecondaryAttribute":"Marc has $10 in his pocket.","TertiaryAttribute":null,"Payload":{"ChoiceOrder":[],"Configuration":{"QuestionDescriptionOption":"UseText"},"DataExportTag":"Q110","DefaultChoices":false,"GradingData":[],"Language":[],"QuestionDescription":"Marc has $10 in his pocket.","QuestionID":"QID12","QuestionText":"Marc has $10 in his pocket.","QuestionText_Unsafe":"Marc has $10 in his pocket.","QuestionType":"DB","Selector":"TB","Validation":{"Settings":{"Type":"None"}}}},{"SurveyID":"SV_8iFeD0xUZQZDDCK","Element":"SQ","PrimaryAttribute":"QID374","SecondaryAttribute":"Marc has $10 in his pocket.","TertiaryAttribute":null,"Payload":{"QuestionText":"Marc has $10 in his pocket.","DefaultChoices":false,"DataExportTag":"Q110","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Marc has $10 in his pocket.","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"QuestionText_Unsafe":"Marc has $10 in his pocket.","QuestionID":"QID374"}},{"SurveyID":"SV_8iFeD0xUZQZDDCK","Element":"SQ","PrimaryAttribute":"QID14","SecondaryAttribute":"Marc has $10 in his pocket. Marc gives $5 to his friend, Tom. How much money does Marc have left...","TertiaryAttribute":null,"Payload":{"ChoiceOrder":[1,2],"Choices":{"1":{"Display":"<span style=\"color:#008000;\"><strong>$5<\/strong><\/span>"},"2":{"Display":"<span style=\"color:#008000;\"><strong>$10<\/strong><\/span>"}},"Configuration":{"QuestionDescriptionOption":"UseText"},"DataExportTag":"p1","Language":[],"QuestionDescription":"Marc has $10 in his pocket. Marc gives $5 to his friend, Tom. How much money does Marc have left...","QuestionID":"QID14","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function()\n{\n\t\/*Place Your Javascript Below This Line*\/\n\tvar that = this;\n\tthis.questionclick = function(event,element){\n    \tif (element.type == 'radio')  {\n\t\t\tthat.clickNextButton();\n    \t}\n\t}\n\t\/* querySelectorAll(\"span.alma\") selects all span elements whose class contains \"alma\" i.e.\n\t   <span class=\"alma korte\" \/> <div class=\"alma\" \/> -- here only the span elment will be selected *\/\n\tsetTimeout(function() {\n\t\tvar elements = document.querySelectorAll(\"div.myTypeForColoringQuestion\");\n\t\tif (elements && elements.length > 0) {\n\t\t\t\/* alert(\"\" + elements[0]); *\/ \/* you can use alert(\"\" + anyVar) to trace out variables *\/\n\t\t\telements[0].style.backgroundColor = \"yellow\"; \/* or html colors like red, green, etc. *\/\n\t\t}\n\t}, 3000); \/* setTimeout(fn, timeout) will take care that after 2000millisec our function will run *\/\n});","QuestionText":"<div class=\"myTypeForColoringQuestion\">Marc has $10 in his pocket.<br \/>\n<br \/>\nMarc gives $5 to his friend, Tom.<br \/>\n<br \/>\nHow much money does Marc have left in his pocket?<br \/>\n<br \/>\n<strong style=\"color: rgb(0, 128, 0);\">Please indicate your very first, intuitive <span style=\"color:#008000;\">answer.<\/span><\/strong>","QuestionText_Unsafe":"<div class=\"myTypeForColoringQuestion\">Marc has $10 in his pocket.<br \/>\n<br \/>\nMarc gives $5 to his friend, Tom.<br \/>\n<br \/>\nHow much money does Marc have left in his pocket?<br \/>\n<br \/>\n<strong style=\"color: rgb(0, 128, 0);\">Please indicate your very first, intuitive <span style=\"color:#008000;\">answer.<\/span><\/strong>","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}}}},{"SurveyID":"SV_8iFeD0xUZQZDDCK","Element":"SQ","PrimaryAttribute":"QID19","SecondaryAttribute":"Marc has $10 in his pocket. Marc gives $5 to his friend, Tom. How much money does Marc have left...","TertiaryAttribute":null,"Payload":{"ChoiceOrder":[1,2],"Cho
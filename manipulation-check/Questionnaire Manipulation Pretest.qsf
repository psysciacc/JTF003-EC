is survey does not allow copying of text.');\n});\n\n\/\/ Add an event listener to detect when the user attempts to leave the page\nwindow.addEventListener('beforeunload', function(event) {\n  \/\/ Display a confirmation message\n  event.returnValue = 'Are you sure you want to leave this page?';\n});","DataVisibility":{"Private":false,"Hidden":false},"NextChoiceId":19,"NextAnswerId":1,"QuestionText_Unsafe":"A car factory in Dongguan has 100 new industrial robot arms that can manufacture 100 self- driving cars in 100 minutes.<br><br>How many minutes must 200 industrial robots take to manufacture 200 self-driving cars?","Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"},"RecodeValues":{"2":"1","16":"2","17":"3","18":"4"},"DataExportTag":"crt6_i","QuestionID":"QID808"}},{"SurveyID":"SV_8iFeD0xUZQZDDCK","Element":"SQ","PrimaryAttribute":"QID821","SecondaryAttribute":"Anna can build a treehouse in 4 weeks, while Mia can build the same treehouse in 12 weeks. How ma...","TertiaryAttribute":null,"Payload":{"QuestionText":"Anna can build a treehouse in 4 weeks, while Mia can build the same treehouse in 12 weeks. <br><br>How many weeks would it take for them to build one treehouse together?","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function()\n{\n\t\/*Place your JavaScript here to run when the page loads*\/\n\/*Place your JavaScript here to run when the page loads*\/\n    window.addEventListener('beforeunload', function (e) {\n        var confirmationMessage = 'Are you sure you want to leave this survey?';\n        (e || window.event).returnValue = confirmationMessage; \/\/ Standard for most browsers\n        return confirmationMessage; \/\/ For some older browsers\n    });\n\n\/\/ Add an event listener to detect when the user attempts to leave the page\nwindow.addEventListener('beforeunload', function(event) {\n  \/\/ Display a confirmation message\n  event.returnValue = 'Are you sure you want to leave this page?';\n});\n\n\/\/ Add an event listener to detect when text is copied\ndocument.addEventListener('copy', function(event) {\n  \/\/ Prevent the default copy behavior\n  event.preventDefault();\n  \n  \/\/ Display a message in a pop-up alert\n  alert('This survey does not allow copying of text.');\n});\n\n});\n\nQualtrics.SurveyEngine.addOnReady(function()\n{\n\t\/*Place your JavaScript here to run when the page is fully displayed*\/\n\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\n\n});","DataExportTag":"crt6_CG_task","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Anna can build a treehouse in 4 weeks, while Mia can build the same treehouse in 12 weeks. How ma...","Choices":{"2":{"Display":"3 weeks "},"16":{"Display":"4 weeks"},"17":{"Display":"8 weeks"},"18":{"Display":"16 weeks"}},"ChoiceOrder":[2,"16","17","18"],"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"RecodeValues":{"2":"1","16":"2","17":"3","18":"4"},"GradingData":[{"ChoiceID":"2","Grades":{"SC_4V0CvXGB2FP6LLE":"0"},"index":1}],"Language":[],"NextChoiceId":19,"NextAnswerId":1,"QuestionID":"QID821"}},{"SurveyID":"SV_8iFeD0xUZQZDDCK","Element":"SQ","PrimaryAttribute":"QID937","SecondaryAttribute":"Anna can build a treehouse in 4 weeks, while Mia can build the same treehouse in 12 weeks. How ma...","TertiaryAttribute":null,"Payload":{"QuestionText":"Anna can build a treehouse in 4 weeks, while Mia can build the same treehouse in 12 weeks. <br><br>How many weeks would it take for them to build one treehouse together?","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function()\n{\n\t\/*Place your JavaScript here to run when the page loads*\/\n\/*Place your JavaScript here to run when the page loads*\/\n    window.addEventListener('beforeunload', function (e) {\n        var confirmationMessage = 'Are you sure you want to leave this survey?';\n        (e || window.event).returnValue = confirmationMessage; \/\/ Standard for most browsers\n        return confirmationMessage; \/\/ For some older browsers\n    });\n\n\/\/ Add an event listener to detect when the user attempts to leave the page\nwindow.addEventListener('beforeunload', function(event) {\n  \/\/ Display a confirmation message\n  event.returnValue = 'Are you sure you want to leave this page?';\n});\n\n\/\/ Add an event listener to detect when text is copied\ndocument.addEventListener('copy', function(event) {\n  \/\/ Prevent the default copy behavior\n  event.preventDefault();\n  \n  \/\/ Display a message in a pop-up alert\n  alert('This survey does not allow copying of text.');\n});\n\n});\n\nQualtrics.SurveyEngine.addOnReady(function()\n{\n\t\/*Place your JavaScript here to run when the page is fully displayed*\/\n\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\n\n});","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Anna can build a treehouse in 4 weeks, while Mia can build the same treehouse in 12 weeks. How ma...","Choices":{"2":{"Display":"3 weeks "},"16":{"Display":"4 weeks"},"17":{"Display":"8 weeks"},"18":{"Display":"16 weeks"}},"ChoiceOrder":[2,"16","17","18"],"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"RecodeValues":{"2":"1","16":"2","17":"3","18":"4"},"GradingData":[{"ChoiceID":"2","Grades":{"SC_4V0CvXGB2FP6LLE":"0"},"index":1}],"Language":[],"NextChoiceId":19,"NextAnswerId":1,"QuestionText_Unsafe":"Anna can build a treehouse in 4 weeks, while Mia can build the same treehouse in 12 weeks. <br><br>How many weeks would it take for them to build one treehouse together?","DataExportTag":"crt6_BJ_task","QuestionID":"QID937"}},{"SurveyID":"SV_8iFeD0xUZQZDDCK","Element":"SQ","PrimaryAttribute":"QID1012","SecondaryAttribute":"Anna can build a treehouse in 4 weeks, while Mia can build the same treehouse in 12 weeks. How ma...","TertiaryAttribute":null,"Payload":{"QuestionText":"Anna can build a treehouse in 4 weeks, while Mia can build the same treehouse in 12 weeks. <br><br>How many weeks would it take for them to build one treehouse together?","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function()\n{\n\t\/*Place your JavaScript here to run when the page loads*\/\n\/*Place your JavaScript here to run when the page loads*\/\n    window.addEventListener('beforeunload', function (e) {\n        var confirmationMessage = 'Are you sure you want to leave this survey?';\n        (e || window.event).returnValue = confirmationMessage; \/\/ Standard for most browsers\n        return confirmationMessage; \/\/ For some older browsers\n    });\n\n\/\/ Add an event listener to detect when the user attempts to leave the page\nwindow.addEventListener('beforeunload', function(event) {\n  \/\/ Display a confirmation message\n  event.returnValue = 'Are you sure you want to leave this page?';\n});\n\n\/\/ Add an event listener to detect when text is copied\ndocument.addEventListener('copy', function(event) {\n  \/\/ Prevent the default copy behavior\n  event.preventDefault();\n  \n  \/\/ Display a message in a pop-up alert\n  alert('This survey does not allow copying of text.');\n});\n\n});\n\nQualtrics.SurveyEngine.addOnReady(function()\n{\n\t\/*Place your JavaScript here to run when the page is fully displayed*\/\n\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\n\n});","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Anna can build a treehouse in 4 weeks, while Mia can build the same treehouse in 12 weeks. How ma...","Choices":{"2":{"Display":"3 weeks "},"16":{"Display":"4 weeks"},"17":{"Display":"8 weeks"},"18":{"Display":"16 weeks"}},"ChoiceOrder":[2,"16","17","18"],"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"RecodeValues":{"2":"1","16":"2","17":"3","18":"4"},"GradingData":[{"ChoiceID":"2","Grades":{"SC_4V0CvXGB2FP6LLE":"0"},"index":1}],"Language":[],"NextChoiceId":19,"NextAnswerId":1,"QuestionText_Unsafe":"Anna can build a treehouse in 4 weeks, while Mia can build the same treehouse in 12 weeks. <br><br>How many weeks would it take for them to build one treehouse together?","DataExportTag":"crt6_IJ_task","QuestionID":"QID1012"}},{"SurveyID":"SV_8iFeD0xUZQZDDCK","Element":"SQ","PrimaryAttribute":"QID1065","SecondaryAttribute":"Anna can build a treehouse in 4 weeks, while Mia can build the same treehouse in 12 weeks. How ma...","TertiaryAttribute":null,"Payload":{"QuestionText":"Anna can build a treehouse in 4 weeks, while Mia can build the same treehouse in 12 weeks. <br><br>How many weeks would it take for them to build one treehouse together?","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function()\n{\n\t\/*Place your JavaScript here to run when the page loads*\/\n\/*Place your JavaScript here to run when the page loads*\/\n    window.addEventListener('beforeunload', function (e) {\n        var confirmationMessage = 'Are you sure you want to leave this survey?';\n        (e || window.event).returnValue = confirmationMessage; \/\/ Standard for most browsers\n        return confirmationMessage; \/\/ For some older browsers\n    });\n\n\/\/ Add an event listener to detect when the user attempts to leave the page\nwindow.addEventListener('beforeunload', function(event) {\n  \/\/ Display a confirmation message\n  event.returnValue = 'Are you sure you want to leave this page?';\n});\n\n\/\/ Add an event listener to detect when text is copied\ndocument.addEventListener('copy', function(event) {\n  \/\/ Prevent the default copy behavior\n  event.preventDefault();\n  \n  \/\/ Display a message in a pop-up alert\n  alert('This survey does not allow copying of text.');\n});\n\n});\n\nQualtrics.SurveyEngine.addOnReady(function()\n{\n\t\/*Place your JavaScript here to run when the page is fully displayed*\/\n\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\n\n});","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Anna can build a treehouse in 4 weeks, while Mia can build the same treehouse in 12 weeks. How ma...","Choices":{"2":{"Display":"3 weeks "},"16":{"Display":"4 weeks"},"17":{"Display":"8 weeks"},"18":{"Display":"16 weeks"}},"ChoiceOrder":[2,"16","17","18"],"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"RecodeValues":{"2":"1","16":"2","17":"3","18":"4"},"GradingData":[{"ChoiceID":"2","Grades":{"SC_4V0CvXGB2FP6LLE":"0"},"index":1}],"Language":[],"NextChoiceId":19,"NextAnswerId":1,"QuestionText_Unsafe":"Anna can build a treehouse in 4 weeks, while Mia can build the same treehouse in 12 weeks. <br><br>How many weeks would it take for them to build one treehouse together?","DataExportTag":"crt6_IJ_task","QuestionID":"QID1065"}},{"SurveyID":"SV_8iFeD0xUZQZDDCK","Element":"SQ","PrimaryAttribute":"QID595","SecondaryAttribute":"Antibiotics expectations \u00a0 \u00a0 Date of approval: 24\/01\/2021 \u00a0 \u00a0 Invitation to our study We would l","TertiaryAttribute":null,"Payload":{"ChoiceOrder":[],"Configuration":{"QuestionDescriptionOption":"UseText"},"DataExportTag":"Info","DataVisibility":{"Hidden":false,"Private":false},"DefaultChoices":false,"GradingData":[],"Language":[],"NextAnswerId":1,"NextChoiceId":1,"QuestionDescription":"Antibiotics expectations \u00a0 \u00a0 Date of approval: 24\/01\/2021 \u00a0 \u00a0 Invitation to our study We would li...","QuestionID":"QID595","QuestionText":"<p style=\"text-align: center;\"><span style=\"font-size:19px;\"><strong><span lang=\"EN-AU\" style=\"line-height: 115%; font-family: &quot;Times New Roman&quot;, serif; color: rgb(0, 0, 10);\">Antibiotics expectations<\/span><\/strong><\/span><\/p>\n\n<p><strong><span lang=\"EN-AU\" style=\"font-size:12.0pt;line-height:115%;font-family:&quot;Times New Roman&quot;,serif;\ncolor:#00000A;mso-ansi-language:EN-AU\">&nbsp;<\/span><\/strong><\/p>\n\n<p><strong><span style=\"font-size:12.0pt;\nline-height:115%;font-family:&quot;Times New Roman&quot;,serif;color:#00000A\">&nbsp;<\/span><\/strong><\/p>\n\n<p style=\"text-align: center;\"><strong><span style=\"font-size:12.0pt;\nline-height:115%;font-family:&quot;Times New Roman&quot;,serif;color:#00000A\">Date of approval: 24\/01\/2021<\/span><\/strong><\/p>\n\n<p><strong><span style=\"font-size:12.0pt;\nline-height:115%;font-family:&quot;Times New Roman&quot;,serif;color:#00000A\">&nbsp;<\/span><\/strong><\/p>\n\n<p><strong><span style=\"font-size:12.0pt;\nline-height:115%;font-family:&quot;Times New Roman&quot;,serif;color:#00000A\">&nbsp;<\/span><\/strong><\/p>\n\n<p><strong><span style=\"font-size:12.0pt;line-height:115%;\nfont-family:&quot;Times New Roman&quot;,serif;color:#00000A\">Invitation to our study<\/span><\/strong><\/p>\n\n<p><span style=\"font-size:12.0pt;line-height:115%;font-family:\n&quot;Times New Roman&quot;,serif;color:#00000A\">We would like to invite you to participate in this research project. You should only participate if you want to; choosing not to take part will not disadvantage you in any way. Before you decide whether you want to take part, it is important for you to read the following information carefully and discuss it with others if you wish. The names of the Principal Investigator and Co-Investigators are listed below and can be contacted for questions if there is anything that is not clear or you would like more information. <\/span><\/p>\n\n<p><span style=\"font-size:12.0pt;line-height:115%;font-family:\n&quot;Times New Roman&quot;,serif;color:#00000A\">&nbsp;<\/span><\/p>\n\n<p><strong><span style=\"font-size:12.0pt;line-height:115%;\nfont-family:&quot;Times New Roman&quot;,serif;color:#00000A\">The Study<\/span><\/strong><\/p>\n\n<p><span style=\"font-size:12.0pt;line-height:115%;font-family:\n&quot;Times New Roman&quot;,serif;color:#00000A;mso-bidi-font-weight:bold\">In this study, we are interested in knowing whether you expect antibiotics from a family<\/span><\/p>\n\n<p><span style=\"font-size:12.0pt;line-height:115%;font-family:\n&quot;Times New Roman&quot;,serif;color:#00000A;mso-bidi-font-weight:bold\">physician in certain situations. <\/span><\/p>\n\n<p><span style=\"font-size:12.0pt;line-height:115%;font-family:\n&quot;Times New Roman&quot;,serif;color:#00000A;mso-bidi-font-weight:bold\">&nbsp;<\/span><\/p>\n\n<p><strong><span style=\"font-size:12.0pt;line-height:115%;\nfont-family:&quot;Times New Roman&quot;,serif;color:#00000A\">Potential risks<\/span><\/strong><\/p>\n\n<p><span style=\"font-size:12.0pt;line-height:115%;font-family:\n&quot;Times New Roman&quot;,serif;color:#00000A;mso-bidi-font-weight:bold\">The risk involved in participation in this experiment is minimal, and no greater than the risks the participant will encounter in everyday life.<\/span><\/p>\n\n<p><span style=\"font-size:12.0pt;line-height:115%;font-family:\n&quot;Times New Roman&quot;,serif;color:#00000A;mso-bidi-font-weight:bold\">&nbsp;<\/span><\/p>\n\n<p><strong><span style=\"font-size:12.0pt;line-height:115%;\nfont-family:&quot;Times New Roman&quot;,serif;color:#00000A\">Informed consent<\/span><\/strong><\/p>\n\n<p><span style=\"font-size:12.0pt;line-height:115%;font-family:\n&quot;Times New Roman&quot;,serif;color:#00000A;mso-bidi-font-weight:bold\">Should you agree to take part in this experiment, you will be asked to provide consent before the experiment commences.<br>\n<br>\n<strong>Withdrawal<\/strong><\/span><br>\n<span style=\"font-size:12.0pt;line-height:115%;font-family:&quot;Times New Roman&quot;,serif;\ncolor:#00000A\">Your participation is voluntary and you will be free to withdraw from the project at any time before you have completed it without giving any reason and without penalty.<\/span><span style=\"font-size:12.0pt;line-height:\n115%;font-family:&quot;Times New Roman&quot;,serif\"> <span style=\"color:#00000A\">If you wish to withdraw, you simply need to close the survey in your browser window. It will not be possible to delete your data after you have completed the experiment, because the data are stored anonymously, so it will not be possible to identify your data.<br>\n<br>\n<strong>Data gathered<\/strong> <\/span><\/span><\/p>\n\n<p><span style=\"font-size:12.0pt;line-height:115%;font-family:Symbol;mso-fareast-font-family:\nSymbol;mso-bidi-font-family:Symbol;color:#00000A\"><span style=\"mso-list:Ignore\">\u00b7<span style=\"font:7.0pt &quot;Times New Roman&quot;\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <\/span><\/span><\/span><span style=\"font-size:12.0pt;line-height:115%;\nfont-family:&quot;Times New Roman&quot;,serif;color:#00000A\">We will collect the following data from each participant: The experimental sessions<\/span><\/p>\n\n<p><span style=\"font-size:12.0pt;line-height:\n115%;font-family:&quot;Times New Roman&quot;,serif;color:#00000A\">will consist of your preferences regarding antibiotics. You will also be asked to provide some sociodemographic questions (e.g., age, gender).<\/span><\/p>\n\n<p><span style=\"font-size:12.0pt;line-height:115%;font-family:Symbol;mso-fareast-font-family:\nSymbol;mso-bidi-font-family:Symbol;color:#00000A\"><span style=\"mso-list:Ignore\">\u00b7<span style=\"font:7.0pt &quot;Times New Roman&quot;\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <\/span><\/span><\/span><span style=\"font-size:12.0pt;line-height:115%;\nfont-family:&quot;Times New Roman&quot;,serif;color:#00000A\">Your experimental data will be fully anonymous, so that it is not possible to identify you from our stored data.<\/span><\/p>\n\n<p><span style=\"font-size:12.0pt;line-height:115%;font-family:Symbol;mso-fareast-font-family:\nSymbol;mso-bidi-font-family:Symbol;color:#00000A\"><span style=\"mso-list:Ignore\">\u00b7<span style=\"font:7.0pt &quot;Times New Roman&quot;\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <\/span><\/span><\/span><span style=\"font-size:12.0pt;line-height:115%;\nfont-family:&quot;Times New Roman&quot;,serif;color:#00000A\">We are using your data to understand in which situations you expect antibiotics. <\/span><\/p>\n\n<p><span style=\"font-size:12.0pt;line-height:115%;font-family:Symbol;mso-fareast-font-family:\nSymbol;mso-bidi-font-family:Symbol;color:#00000A\"><span style=\"mso-list:Ignore\">\u00b7<span style=\"font:7.0pt &quot;Times New Roman&quot;\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <\/span><\/span><\/span><span style=\"font-size:12.0pt;line-height:115%;\nfont-family:&quot;Times New Roman&quot;,serif;color:#00000A\">Your data will be gathered by the principal investigator and co-investigators listed below. <\/span><\/p>\n\n<p><span style=\"font-size:12.0pt;line-height:115%;font-family:Symbol;mso-fareast-font-family:\nSymbol;mso-bidi-font-family:Symbol;color:#00000A\"><span style=\"mso-list:Ignore\">\u00b7<span style=\"font:7.0pt &quot;Times New Roman&quot;\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <\/span><\/span><\/span><span style=\"font-size:12.0pt;line-height:115%;\nfont-family:&quot;Times New Roman&quot;,serif;color:#00000A\">Your data will be stored in electronic form on a secure computer or server.<\/span><\/p>\n\n<p><span style=\"font-size:12.0pt;line-height:115%;font-family:Symbol;mso-fareast-font-family:\nSymbol;mso-bidi-font-family:Symbol;color:#00000A\"><span style=\"mso-list:Ignore\">\u00b7<span style=\"font:7.0pt &quot;Times New Roman&quot;\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <\/span><\/span><\/span><span style=\"font-size:12.0pt;line-height:115%;\nfont-family:&quot;Times New Roman&quot;,serif;color:#00000A\">Your anonymous data may be published in scientific journal articles, and shared in permanent, publicly accessible archives accessible from any country.<\/span><\/p>\n\n<p>&nbsp;<\/p>\n\n<p><strong><span style=\"font-size:12.0pt;line-height:115%;\nfont-family:&quot;Times New Roman&quot;,serif;color:#00000A\">Ethical approval<\/span><\/strong><\/p>\n\n<p><span style=\"font-size:12.0pt;line-height:115%;font-family:\n&quot;Times New Roman&quot;,serif;color:#00000A\">This project has been reviewed on behalf of the University of Essex Science and Health Ethics Sub-committee, and has been given approval with the following Application ID: ETH2021-0608. <\/span><\/p>\n\n<p><strong><span style=\"font-size:12.0pt;line-height:115%;\nfont-family:&quot;Times New Roman&quot;,serif;color:#00000A\">&nbsp;<\/span><\/strong><\/p>\n\n<p><strong><span style=\"font-size:12.0pt;line-height:115%;\nfont-family:&quot;Times New Roman&quot;,serif;color:#00000A\">Concerns and complaints<\/span><\/strong><\/p>\n\n<p><span style=\"font-size:12.0pt;line-height:115%;font-family:\n&quot;Times New Roman&quot;,serif;color:#00000A\">If you have any concerns about any aspect of the study or you have a complaint, in the first instance please contact the Principal Investigator of the project (see contact details below). If you are still concerned or you think your complaint has not been addressed to your satisfaction, please contact the Director of Research in the Principal Investigator\u2019s department (see below). If you are still not satisfied, please contact the University\u2019s Research Governance and Planning Manager (Sarah Manning-Press).<\/span><\/p>\n\n<p><strong><span style=\"font-size:12.0pt;line-height:115%;\nfont-family:&quot;Times New Roman&quot;,serif;color:#00000A\">&nbsp;<\/span><\/strong><\/p>\n\n<p><strong><span style=\"font-size:12.0pt;line-height:115%;\nfont-family:&quot;Times New Roman&quot;,serif;color:#00000A\">&nbsp;<\/span><\/strong><\/p>\n\n<p><strong><span style=\"font-size:12.0pt;line-height:115%;\nfont-family:&quot;Times New Roman&quot;,serif;color:#00000A\">Contact details<\/span><\/strong><\/p>\n\n<p><span style=\"font-size:12.0pt;line-height:115%;font-family:\n&quot;Times New Roman&quot;,serif;color:#00000A\">&nbsp;<\/span><\/p>\n\n<p><strong><u><span style=\"font-size:12.0pt;line-height:115%;font-family:&quot;Times New Roman&quot;,serif;\ncolor:#00000A\">Principal investigator<\/span><\/u><\/strong><\/p>\n\n<p><span style=\"font-size:12.0pt;line-height:115%;font-family:\n&quot;Times New Roman&quot;,serif;color:#00000A\">Miss Andriana Theodoropoulou (<\/span><span style=\"font-size:12.0pt;line-height:\n115%;font-family:&quot;Times New Roman&quot;,serif\">a.theodoropoulou@essex.ac.uk<\/span><span style=\"font-size:12.0pt;line-height:115%;font-family:&quot;Times New Roman&quot;,serif;\ncolor:#00000A\">)<\/span><\/p>\n\n<p><span style=\"font-size:12.0pt;line-height:115%;font-family:\n&quot;Times New Roman&quot;,serif;color:#00000A\">&nbsp;<\/span><\/p>\n\n<p><strong><u><span style=\"font-size:12.0pt;line-height:115%;font-family:&quot;Times New Roman&quot;,serif;\ncolor:#00000A\">Co-investigators<\/span><\/u><\/strong><\/p>\n\n<p><span style=\"font-size:12.0pt;line-height:115%;font-family:\n&quot;Times New Roman&quot;,serif;color:#00000A\">Dr Miroslav Sirota (<\/span><span style=\"font-size:12.0pt;line-height:\n115%;font-family:&quot;Times New Roman&quot;,serif\">msirota@essex.ac.uk<\/span><span style=\"font-size:12.0pt;line-height:115%;font-family:&quot;Times New Roman&quot;,serif;\ncolor:#00000A\">)<\/span><\/p>\n\n<p><span style=\"font-size:12.0pt;line-height:115%;font-family:\n&quot;Times New Roman&quot;,serif;color:#00000A\">Dr Jonathan Rolison (<\/span><span style=\"font-size:12.0pt;line-height:115%;font-family:\n&quot;Times New Roman&quot;,serif\">jrolison@essex.ac.uk<\/span><span style=\"font-size:\n12.0pt;line-height:115%;font-family:&quot;Times New Roman&quot;,serif;color:#00000A\">)<\/span><\/p>\n\n<p><span style=\"font-size:12.0pt;line-height:115%;font-family:\n&quot;Times New Roman&quot;,serif;color:#00000A\">Dr Matteo Lisi (<\/span><span style=\"font-size:12.0pt;line-height:115%;font-family:&quot;Times New Roman&quot;,serif\">m.lisi@essex.ac.uk<\/span><span style=\"font-size:12.0pt;line-height:115%;font-family:&quot;Times New Roman&quot;,serif;\ncolor:#00000A\">)<\/span><\/p>\n\n<p><span style=\"font-size:12.0pt;line-height:115%;font-family:\n&quot;Times New Roman&quot;,serif;color:#00000A\">&nbsp;<\/span><\/p>\n\n<p><strong><u><span style=\"font-size:12.0pt;line-height:115%;font-family:&quot;Times New Roman&quot;,serif;\ncolor:#00000A\">Director of Research, Dept of Psychology<\/span><\/u><\/strong><\/p>\n\n<p><span style=\"font-size:12.0pt;line-height:115%;font-family:\n&quot;Times New Roman&quot;,serif;color:#00000A\">Prof Sheina Orbell (sorbell@essex.ac.uk<\/span><span style=\"font-size:12.0pt;line-height:\n115%;font-family:&quot;Times New Roman&quot;,serif\">)<\/span><\/p>\n\n<p><span style=\"font-size:12.0pt;line-height:115%;font-family:\n&quot;Times New Roman&quot;,serif;color:#00000A\">&nbsp;<\/span><\/p>\n\n<p><strong><u><span style=\"font-size:12.0pt;line-height:115%;font-family:&quot;Times New Roman&quot;,serif;\ncolor:#00000A\">University of Essex Research Governance and Planning Manager<\/span><\/u><\/strong><\/p>\n\n<p><span style=\"font-size:12.0pt;line-height:115%;font-family:\n&quot;Times New Roman&quot;,serif;color:#00000A\">Sarah Manning-Press, Research &amp; Enterprise Office, University of Essex, Wivenhoe Park, CO4 3SQ,<\/span><\/p>\n\n<p><span style=\"font-size:12.0pt;line-height:115%;font-family:\n&quot;Times New Roman&quot;,serif;color:#00000A\">Colchester. Email: <\/span><span style=\"mso-bidi-font-size:12.0pt;\nline-height:115%;font-family:&quot;Cambria&quot;,serif;mso-fareast-font-family:&quot;MS Mincho&quot;;\nmso-bidi-font-family:Arial\">sarahm@essex.ac.uk<\/span><span style=\"font-size:12.0pt;line-height:115%;font-family:&quot;Times New Roman&quot;,serif;\ncolor:#00000A\">; Phone: 01206-873561<\/span><\/p>","QuestionText_Unsafe":"<p style=\"text-align: center;\"><span style=\"font-size:19px;\"><strong><span lang=\"EN-AU\" style=\"line-height: 115%; font-family: &quot;Times New Roman&quot;, serif; color: rgb(0, 0, 10);\">Antibiotics expectations<\/span><\/strong><\/span><\/p>\n\n<p><strong><span lang=\"EN-AU\" style=\"font-size:12.0pt;line-height:115%;font-family:&quot;Times New Roman&quot;,serif;\ncolor:#00000A;mso-ansi-language:EN-AU\">&nbsp;<\/span><\/strong><\/p>\n\n<p><strong><span style=\"font-size:12.0pt;\nline-height:115%;font-family:&quot;Times New Roman&quot;,serif;color:#00000A\">&nbsp;<\/span><\/strong><\/p>\n\n<p style=\"text-align: center;\"><strong><span style=\"font-size:12.0pt;\nline-height:115%;font-family:&quot;Times New Roman&quot;,serif;color:#00000A\">Date of approval: 24\/01\/2021<\/span><\/strong><\/p>\n\n<p><strong><span style=\"font-size:12.0pt;\nline-height:115%;font-family:&quot;Times New Roman&quot;,serif;color:#00000A\">&nbsp;<\/span><\/strong><\/p>\n\n<p><strong><span style=\"font-size:12.0pt;\nline-height:115%;font-family:&quot;Times New Roman&quot;,serif;color:#00000A\">&nbsp;<\/span><\/strong><\/p>\n\n<p><strong><span style=\"font-size:12.0pt;line-height:115%;\nfont-family:&quot;Times New Roman&quot;,serif;color:#00000A\">Invitation to our study<\/span><\/strong><\/p>\n\n<p><span style=\"font-size:12.0pt;line-height:115%;font-family:\n&quot;Times New Roman&quot;,serif;color:#00000A\">We would like to invite you to participate in this research project. You should only participate if you want to; choosing not to take part will not disadvantage you in any way. Before you decide whether you want to take part, it is important for you to read the following information carefully and discuss it with others if you wish. The names of the Principal Investigator and Co-Investigators are listed below and can be contacted for questions if there is anything that is not clear or you would like more information. <\/span><\/p>\n\n<p><span style=\"font-size:12.0pt;line-height:115%;font-family:\n&quot;Times New Roman&quot;,serif;color:#00000A\">&nbsp;<\/span><\/p>\n\n<p><strong><span style=\"font-size:12.0pt;line-height:115%;\nfont-family:&quot;Times New Roman&quot;,serif;color:#00000A\">The Study<\/span><\/strong><\/p>\n\n<p><span style=\"font-size:12.0pt;line-height:115%;font-family:\n&quot;Times New Roman&quot;,serif;color:#00000A;mso-bidi-font-weight:bold\">In this study, we are interested in knowing whether you expect antibiotics from a family<\/span><\/p>\n\n<p><span style=\"font-size:12.0pt;line-height:115%;font-family:\n&quot;Times New Roman&quot;,serif;color:#00000A;mso-bidi-font-weight:bold\">physician in certain situations. <\/span><\/p>\n\n<p><span style=\"font-size:12.0pt;line-height:115%;font-family:\n&quot;Times New Roman&quot;,serif;color:#00000A;mso-bidi-font-weight:bold\">&nbsp;<\/span><\/p>\n\n<p><strong><span style=\"font-size:12.0pt;line-height:115%;\nfont-family:&quot;Times New Roman&quot;,serif;color:#00000A\">Potential risks<\/span><\/strong><\/p>\n\n<p><span style=\"font-size:12.0pt;line-height:115%;font-family:\n&quot;Times New Roman&quot;,serif;color:#00000A;mso-bidi-font-weight:bold\">The risk involved in participation in this experiment is minimal, and no greater than the risks the participant will encounter in everyday life.<\/span><\/p>\n\n<p><span style=\"font-size:12.0pt;line-height:115%;font-family:\n&quot;Times New Roman&quot;,serif;color:#00000A;mso-bidi-font-weight:bold\">&nbsp;<\/span><\/p>\n\n<p><strong><span style=\"font-size:12.0pt;line-height:115%;\nfont-family:&quot;Times New Roman&quot;,serif;color:#00000A\">Informed consent<\/span><\/strong><\/p>\n\n<p><span style=\"font-size:12.0pt;line-height:115%;font-family:\n&quot;Times New Roman&quot;,serif;color:#00000A;mso-bidi-font-weight:bold\">Should you agree to take part in this experiment, you will be asked to provide consent before the experiment commences.<br>\n<br>\n<strong>Withdrawal<\/strong><\/span><br>\n<span style=\"font-size:12.0pt;line-height:115%;font-family:&quot;Times New Roman&quot;,serif;\ncolor:#00000A\">Your participation is voluntary and you will be free to withdraw from the project at any time before you have completed it without giving any reason and without penalty.<\/span><span style=\"font-size:12.0pt;line-height:\n115%;font-family:&quot;Times New Roman&quot;,serif\"> <span style=\"color:#00000A\">If you wish to withdraw, you simply need to close the survey in your browser window. It will not be possible to delete your data after you have completed the experiment, because the data are stored anonymously, so it will not be possible to identify your data.<br>\n<br>\n<strong>Data gathered<\/strong> <\/span><\/span><\/p>\n\n<p><span style=\"font-size:12.0pt;line-height:115%;font-family:Symbol;mso-fareast-font-family:\nSymbol;mso-bidi-font-family:Symbol;color:#00000A\"><span style=\"mso-list:Ignore\">\u00b7<span style=\"font:7.0pt &quot;Times New Roman&quot;\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <\/span><\/span><\/span><span style=\"font-size:12.0pt;line-height:115%;\nfont-family:&quot;Times New Roman&quot;,serif;color:#00000A\">We will collect the following data from each participant: The experimental sessions<\/span><\/p>\n\n<p><span style=\"font-size:12.0pt;line-height:\n115%;font-family:&quot;Times New Roman&quot;,serif;color:#00000A\">will consist of your preferences regarding antibiotics. You will also be asked to provide some sociodemographic questions (e.g., age, gender).<\/span><\/p>\n\n<p><span style=\"font-size:12.0pt;line-height:115%;font-family:Symbol;mso-fareast-font-family:\nSymbol;mso-bidi-font-family:Symbol;color:#00000A\"><span style=\"mso-list:Ignore\">\u00b7<span style=\"font:7.0pt &quot;Times New Roman&quot;\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <\/span><\/span><\/span><span style=\"font-size:12.0pt;line-height:115%;\nfont-family:&quot;Times New Roman&quot;,serif;color:#00000A\">Your experimental data will be fully anonymous, so that it is not possible to identify you from our stored data.<\/span><\/p>\n\n<p><span style=\"font-size:12.0pt;line-height:115%;font-family:Symbol;mso-fareast-font-family:\nSymbol;mso-bidi-font-family:Symbol;color:#00000A\"><span style=\"mso-list:Ignore\">\u00b7<span style=\"font:7.0pt &quot;Times New Roman&quot;\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <\/span><\/span><\/span><span style=\"font-size:12.0pt;line-height:115%;\nfont-family:&quot;Times New Roman&quot;,serif;color:#00000A\">We are using your data to understand in which situations you expect antibiotics. <\/span><\/p>\n\n<p><span style=\"font-size:12.0pt;line-height:115%;font-family:Symbol;mso-fareast-font-family:\nSymbol;mso-bidi-font-family:Symbol;color:#00000A\"><span style=\"mso-list:Ignore\">\u00b7<span style=\"font:7.0pt &quot;Times New Roman&quot;\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <\/span><\/span><\/span><span style=\"font-size:12.0pt;line-height:115%;\nfont-family:&quot;Times New Roman&quot;,serif;color:#00000A\">Your data will be gathered by the principal investigator and co-investigators listed below. <\/span><\/p>\n\n<p><span style=\"font-size:12.0pt;line-height:115%;font-family:Symbol;mso-fareast-font-family:\nSymbol;mso-bidi-font-family:Symbol;color:#00000A\"><span style=\"mso-list:Ignore\">\u00b7<span style=\"font:7.0pt &quot;Times New Roman&quot;\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <\/span><\/span><\/span><span style=\"font-size:12.0pt;line-height:115%;\nfont-family:&quot;Times New Roman&quot;,serif;color:#00000A\">Your data will be stored in electronic form on a secure computer or server.<\/span><\/p>\n\n<p><span style=\"font-size:12.0pt;line-height:115%;font-family:Symbol;mso-fareast-font-family:\nSymbol;mso-bidi-font-family:Symbol;color:#00000A\"><span style=\"mso-list:Ignore\">\u00b7<span style=\"font:7.0pt &quot;Times New Roman&quot;\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <\/span><\/span><\/span><span style=\"font-size:12.0pt;line-height:115%;\nfont-family:&quot;Times New Roman&quot;,serif;color:#00000A\">Your anonymous data may be published in scientific journal articles, and shared in permanent, publicly accessible archives accessible from any country.<\/span><\/p>\n\n<p>&nbsp;<\/p>\n\n<p><strong><span style=\"font-size:12.0pt;line-height:115%;\nfont-family:&quot;Times New Roman&quot;,serif;color:#00000A\">Ethical approval<\/span><\/strong><\/p>\n\n<p><span style=\"font-size:12.0pt;line-height:115%;font-family:\n&quot;Times New Roman&quot;,serif;color:#00000A\">This project has been reviewed on behalf of the University of Essex Science and Health Ethics Sub-committee, and has been given approval with the following Application ID: ETH2021-0608. <\/span><\/p>\n\n<p><strong><span style=\"font-size:12.0pt;line-height:115%;\nfont-family:&quot;Times New Roman&quot;,serif;color:#00000A\">&nbsp;<\/span><\/strong><\/p>\n\n<p><strong><span style=\"font-size:12.0pt;line-height:115%;\nfont-family:&quot;Times New Roman&quot;,serif;color:#00000A\">Concerns and complaints<\/span><\/strong><\/p>\n\n<p><span style=\"font-size:12.0pt;line-height:115%;font-family:\n&quot;Times New Roman&quot;,serif;color:#00000A\">If you have any concerns about any aspect of the study or you have a complaint, in the first instance please contact the Principal Investigator of the project (see contact details below). If you are still concerned or you think your complaint has not been addressed to your satisfaction, please contact the Director of Research in the Principal Investigator\u2019s department (see below). If you are still not satisfied, please contact the University\u2019s Research Governance and Planning Manager (Sarah Manning-Press).<\/span><\/p>\n\n<p><strong><span style=\"font-size:12.0pt;line-height:115%;\nfont-family:&quot;Times New Roman&quot;,serif;color:#00000A\">&nbsp;<\/span><\/strong><\/p>\n\n<p><strong><span style=\"font-size:12.0pt;line-height:115%;\nfont-family:&quot;Times New Roman&quot;,serif;color:#00000A\">&nbsp;<\/span><\/strong><\/p>\n\n<p><strong><span style=\"font-size:12.0pt;line-height:115%;\nfont-family:&quot;Times New Roman&quot;,serif;color:#00000A\">Contact details<\/span><\/strong><\/p>\n\n<p><span style=\"font-size:12.0pt;line-height:115%;font-family:\n&quot;Times New Roman&quot;,serif;color:#00000A\">&nbsp;<\/span><\/p>\n\n<p><strong><u><span style=\"font-size:12.0pt;line-height:115%;font-family:&quot;Times New Roman&quot;,serif;\ncolor:#00000A\">Principal investigator<\/span><\/u><\/strong><\/p>\n\n<p><span style=\"font-size:12.0pt;line-height:115%;font-family:\n&quot;Times New Roman&quot;,serif;color:#00000A\">Miss Andriana Theodoropoulou (<\/span><span style=\"font-size:12.0pt;line-height:\n115%;font-family:&quot;Times New Roman&quot;,serif\">a.theodoropoulou@essex.ac.uk<\/span><span style=\"font-size:12.0pt;line-height:115%;font-family:&quot;Times New Roman&quot;,serif;\ncolor:#00000A\">)<\/span><\/p>\n\n<p><span style=\"font-size:12.0pt;line-height:115%;font-family:\n&quot;Times New Roman&quot;,serif;color:#00000A\">&nbsp;<\/span><\/p>\n\n<p><strong><u><span style=\"font-size:12.0pt;line-height:115%;font-family:&quot;Times New Roman&quot;,serif;\ncolor:#00000A\">Co-investigators<\/span><\/u><\/strong><\/p>\n\n<p><span style=\"font-size:12.0pt;line-height:115%;font-family:\n&quot;Times New Roman&quot;,serif;color:#00000A\">Dr Miroslav Sirota (<\/span><span style=\"font-size:12.0pt;line-height:\n115%;font-family:&quot;Times New Roman&quot;,serif\">msirota@essex.ac.uk<\/span><span style=\"font-size:12.0pt;line-height:115%;font-family:&quot;Times New Roman&quot;,serif;\ncolor:#00000A\">)<\/span><\/p>\n\n<p><span style=\"font-size:12.0pt;line-height:115%;font-family:\n&quot;Times New Roman&quot;,serif;color:#00000A\">Dr Jonathan Rolison (<\/span><span style=\"font-size:12.0pt;line-height:115%;font-family:\n&quot;Times New Roman&quot;,serif\">jrolison@essex.ac.uk<\/span><span style=\"font-size:\n12.0pt;line-height:115%;font-family:&quot;Times New Roman&quot;,serif;color:#00000A\">)<\/span><\/p>\n\n<p><span style=\"font-size:12.0pt;line-height:115%;font-family:\n&quot;Times New Roman&quot;,serif;color:#00000A\">Dr Matteo Lisi (<\/span><span style=\"font-size:12.0pt;line-height:115%;font-family:&quot;Times New Roman&quot;,serif\">m.lisi@essex.ac.uk<\/span><span style=\"font-size:12.0pt;line-height:115%;font-family:&quot;Times New Roman&quot;,serif;\ncolor:#00000A\">)<\/span><\/p>\n\n<p><span style=\"font-size:12.0pt;line-height:115%;font-family:\n&quot;Times New Roman&quot;,serif;color:#00000A\">&nbsp;<\/span><\/p>\n\n<p><strong><u><span style=\"font-size:12.0pt;line-height:115%;font-family:&quot;Times New Roman&quot;,serif;\ncolor:#00000A\">Director of Research, Dept of Psychology<\/span><\/u><\/strong><\/p>\n\n<p><span style=\"font-size:12.0pt;line-height:115%;font-family:\n&quot;Times New Roman&quot;,serif;color:#00000A\">Prof Sheina Orbell (sorbell@essex.ac.uk<\/span><span style=\"font-size:12.0pt;line-height:\n115%;font-family:&quot;Times New Roman&quot;,serif\">)<\/span><\/p>\n\n<p><span style=\"font-size:12.0pt;line-height:115%;font-family:\n&quot;Times New Roman&quot;,serif;color:#00000A\">&nbsp;<\/span><\/p>\n\n<p><strong><u><span style=\"font-size:12.0pt;line-height:115%;font-family:&quot;Times New Roman&quot;,serif;\ncolor:#00000A\">University of Essex Research Governance and Planning Manager<\/span><\/u><\/strong><\/p>\n\n<p><span style=\"font-size:12.0pt;line-height:115%;font-family:\n&quot;Times New Roman&quot;,serif;color:#00000A\">Sarah Manning-Press, Re
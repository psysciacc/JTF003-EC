d":"+30 days","PartialDeletion":null,"EOSMessage":"MS_85HNQB3nBNyStZs","BallotBoxStuffingPreventionBehavior":null,"BallotBoxStuffingPreventionMessage":null,"BallotBoxStuffingPreventionMessageLibrary":null,"BallotBoxStuffingPreventionURL":null,"EOSMessageLibrary":"UR_4GwcVrtAa4BNk8a","SurveyName":"PSA Reading Pretest"}},{"SurveyID":"SV_erphejWdpLjnNpI","Element":"SCO","PrimaryAttribute":"Scoring","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"ScoringCategories":[],"ScoringCategoryGroups":[],"ScoringSummaryCategory":null,"ScoringSummaryAfterQuestions":0,"ScoringSummaryAfterSurvey":0,"DefaultScoringCategory":null,"AutoScoringCategory":null}},{"SurveyID":"SV_erphejWdpLjnNpI","Element":"PROJ","PrimaryAttribute":"CORE","SecondaryAttribute":null,"TertiaryAttribute":"1.1.0","Payload":{"ProjectCategory":"CORE","SchemaVersion":"1.1.0"}},{"SurveyID":"SV_erphejWdpLjnNpI","Element":"STAT","PrimaryAttribute":"Survey Statistics","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"MobileCompatible":true,"ID":"Survey Statistics"}},{"SurveyID":"SV_erphejWdpLjnNpI","Element":"QC","PrimaryAttribute":"Survey Question Count","SecondaryAttribute":"1095","TertiaryAttribute":null,"Payload":null},{"SurveyID":"SV_erphejWdpLjnNpI","Element":"SQ","PrimaryAttribute":"QID1044","SecondaryAttribute":"A car factory has 100 new industrial robot arms that can manufacture 100 self-driving cars in 100...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div>A car factory has 100 new industrial robot arms that can manufacture 100 self-driving cars in 100 minutes.<br>\n<br>\nHow many minutes must 200 industrial robots take to manufacture 200 self-driving cars?<\/div>","DefaultChoices":false,"QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"A car factory has 100 new industrial robot arms that can manufacture 100 self-driving cars in 100...","Choices":{"1":{"Display":"Option A"},"2":{"Display":"Option B"},"3":{"Display":"Option C"},"4":{"Display":"Option D"}},"ChoiceOrder":["1","2","3","4"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"},"QuestionText_Unsafe":"<div>Usain ran a 200-metre race in Paris and achieved the tenth quickest and tenth slowest time. <br><\/div><div><br><\/div><div>How many runners ran in this race?\n<\/div>","DataExportTag":"CRT4_a","QuestionID":"QID1044"}},{"SurveyID":"SV_erphejWdpLjnNpI","Element":"SQ","PrimaryAttribute":"QID1095","SecondaryAttribute":"After each problem, we will present you with some easy verification questions to check whether yo...","TertiaryAttribute":null,"Payload":{"QuestionText":"After each problem, we will present you with some easy verification questions to check whether you actually read the problems. This is simply to make sure that participants are complying with the instructions and actually reading the problems (instead of clicking through them without paying attention). There is no need to worry. When you read the problems, you will have no trouble at all answering the verification questions.<br>\n&nbsp;","DefaultChoices":false,"DataExportTag":"Instr_f","QuestionID":"QID1095","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"After each problem, we will present you with some easy verification questions to check whether yo...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_erphejWdpLjnNpI","Element":"SQ","PrimaryAttribute":"QID677","SecondaryAttribute":"Almost done. Please answer the following questions.","TertiaryAttribute":null,"Payload":{"QuestionText":"Almost done. Please answer the following questions.","DefaultChoices":false,"DataExportTag":"Sociodemo","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Almost done. Please answer the following questions.","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":1,"NextAnswerId":1,"QuestionID":"QID677"}},{"SurveyID":"SV_erphejWdpLjnNpI","Element":"SQ","PrimaryAttribute":"QID1052","SecondaryAttribute":"Anna can build a treehouse in 4 weeks, while Mia can build the same treehouse in 12 weeks. How ma...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div>Anna can build a treehouse in 4 weeks, while Mia can build the same treehouse in 12 weeks.<br \/>\n<br \/>\nHow many weeks would it take for them to build one treehouse together?<\/div>","DefaultChoices":false,"QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Anna can build a treehouse in 4 weeks, while Mia can build the same treehouse in 12 weeks. How ma...","Choices":{"1":{"Display":"Option A"},"2":{"Display":"Option B"},"3":{"Display":"Option C"},"4":{"Display":"Option D"}},"ChoiceOrder":["1","2","3","4"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"},"QuestionText_Unsafe":"<div>Marie used a strong yeast for making bread dough. In a large proofing basket, a dough ball doubles in size every hour. Marie left the dough for 24 hours and it filled the basket completely. <br><\/div><div><br><\/div><div>If she only wanted half the basket filled, how long should she leave the dough?\n<\/div>","DataExportTag":"CRT6_a","QuestionID":"QID1052"}},{"SurveyID":"SV_erphejWdpLjnNpI","Element":"SQ","PrimaryAttribute":"QID671","SecondaryAttribute":"\u201cAs you do not wish to participate in this study, please return your submission on Prolific by se.","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong><em>\u201cAs you do not wish to participate in this study, please \nreturn your submission on Prolific by selecting the 'Stop without \ncompleting' button.\u201d<\/em><\/strong>","QuestionJS":"Qualtrics.SurveyEngine.addOnReady(function () {\n    $('NextButton').hide();\n    $('PreviousButton').hide();\n});","DefaultChoices":false,"DataExportTag":"NoConsentMessage","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"\u201cAs you do not wish to participate in this study, please return your submission on Prolific by se...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID671"}},{"SurveyID":"SV_erphejWdpLjnNpI","Element":"SQ","PrimaryAttribute":"QID672","SecondaryAttribute":"Before you start, please switch off your phone\/e-mail\/music so you can focus on this study. \u00a0 Wha..","TertiaryAttribute":null,"Payload":{"QuestionText":"Before you start, please switch off your phone\/e-mail\/music so you can focus on this study.<br \/>\n&nbsp;\n<div><em>What is your Prolific ID?<\/em><\/div>\n\n<div><em>Please note that this response should auto-fill with the correct ID<\/em><\/div>","DefaultChoices":{"TEXT":{"Text":"${e:\/\/Field\/PROLIFIC_PID}"}},"DataExportTag":"PA","QuestionType":"TE","Selector":"SL","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","InputWidth":200},"QuestionDescription":"Before you start, please switch off your phone\/e-mail\/music so you can focus on this study. \u00a0 Wha...","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":1,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionID":"QID672"}},{"SurveyID":"SV_erphejWdpLjnNpI","Element":"SQ","PrimaryAttribute":"QID669","SecondaryAttribute":"Consent \u00a0 1.\u00a0\u00a0 I confirm that I have read and understood the Information Sheet for this study. \u00a0","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong>Consent<\/strong><\/p>\n\n<p>&nbsp;<\/p>\n\n<p>1.&nbsp;&nbsp; I confirm that I have read and understood the Information Sheet for this study. <br><\/p>\n\n<p>&nbsp;<\/p>\n\n<p>2.&nbsp;&nbsp; I understand that my participation is voluntary and that I am free to withdraw from the project at any time without giving any reason and without penalty. I understand that any data collected up to the point of my withdrawal cannot be withdrawn because it cannot be identified.<o:p><\/o:p><\/p>\n\n<p>&nbsp;<\/p>\n\n<p>3.&nbsp;&nbsp; I understand that the identifiable data provided will be securely stored and accessible only to the members of the research team directly involved in the project, and that confidentiality will be maintained.<o:p><\/o:p><\/p>\n\n<p>&nbsp;<\/p>\n\n<p>4.&nbsp;&nbsp; I understand that my fully anonymised data will be used for the purpose of this study.<o:p><\/o:p><\/p>\n\n<p>&nbsp;<\/p>\n\n<p>5.&nbsp;&nbsp; I understand that the data collected about me will be used to support other research in the future, and may be shared anonymously with other researchers. <o:p><\/o:p><\/p>\n\n<p>&nbsp;<\/p>\n\n<p>6.&nbsp;&nbsp; I give permission for all the anonymised data and transcripts that I provide to be deposited in public repository (e.g., Open Science Framework) so that they will be available for future research and learning activities by other individuals.<o:p><\/o:p><\/p>\n\n<p>&nbsp;<\/p>\n\n<p>7.&nbsp;&nbsp; I agree to take part in the above study.<br>\n&nbsp;<\/p>Please select your answer below to indicate whether you consent or not to participate in the study\n\n<p>&nbsp;<\/p>\n\n<p>&nbsp;<\/p>\n\n<p><o:p><\/o:p><\/p>","DefaultChoices":false,"DataExportTag":"Consent","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Consent \u00a0 1.\u00a0\u00a0 I confirm that I have read and understood the Information Sheet for this study. \u00a0...","Choices":{"1":{"Display":"I consent"},"2":{"Display":"I do not consent"}},"ChoiceOrder":[1,2],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":3,"NextAnswerId":1,"QuestionID":"QID669"}},{"SurveyID":"SV_erphejWdpLjnNpI","Element":"SQ","PrimaryAttribute":"QID1036","SecondaryAttribute":"Ellen is driving in a car race and she overtakes a driver who is in 34th place. What is Ellen's c...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div>Ellen is driving in a car race and she overtakes a driver who is in 34th place.<br \/>\n<br \/>\nWhat is Ellen&#39;s current position?<\/div>","DefaultChoices":false,"QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Ellen is driving in a car race and she overtakes a driver who is in 34th place. What is Ellen's c...","Choices":{"1":{"Display":"Option A"},"2":{"Display":"Option B"},"3":{"Display":"Option C"},"4":{"Display":"Option D"}},"ChoiceOrder":["1","2","3","4"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"},"QuestionText_Unsafe":"<div>Mark\u2019s father loves ales, politics and Great Britain. He has four children, and the names of the first three are England, Wales, and Scotland. <br><\/div><div><br><\/div><div>The name of the fourth child is: \n<\/div>","DataExportTag":"CRT2_a","QuestionID":"QID1036"}},{"SurveyID":"SV_erphejWdpLjnNpI","Element":"SQ","PrimaryAttribute":"QID864","SecondaryAttribute":"Emma\u2019s father loves the seasons and the cyclical changes in nature. He has four daughters, and th.","TertiaryAttribute":null,"Payload":{"QuestionText":"Emma&rsquo;s father loves the seasons and the cyclical changes in nature. He has four daughters, and the names of the first three are Spring, Summer, and Autumn.<br \/>\n<br \/>\nThe name of the fourth daughter is:\n<div>&nbsp;<\/div>","DefaultChoices":false,"DataExportTag":"CRT1_a","QuestionID":"QID864","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Emma\u2019s father loves the seasons and the cyclical changes in nature. He has four daughters, and th...","Choices":{"1":{"Display":"Option A"},"2":{"Display":"Option B"},"3":{"Display":"Option C"},"4":{"Display":"Option D"}},"ChoiceOrder":["1","2","3","4"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"}}},{"SurveyID":"SV_erphejWdpLjnNpI","Element":"SQ","PrimaryAttribute":"QID1068","SecondaryAttribute":"gender","TertiaryAttribute":null,"Payload":{"ChoiceOrder":["1","2"],"Choices":{"1":{"Display":"Male"},"2":{"Display":"Female"}},"Configuration":{"QuestionDescriptionOption":"SpecifyLabel"},"DataExportTag":"Sex","DataVisibility":{"Hidden":false,"Private":false},"Language":[],"NextAnswerId":1,"NextChoiceId":4,"QuestionDescription":"gender","QuestionID":"QID1068","QuestionText":"<div>What is your sex?<\/div><div><br><\/div><div>If you are considering how to answer, use the sex recorded on your birth certificate or Gender Recognition Certificate.<br><\/div>","QuestionText_Unsafe":"<div>What is your sex?<\/div><div><br><\/div><div>If you are considering how to answer, use the sex recorded on your birth certificate or Gender Recognition Certificate.<br><\/div>","QuestionType":"MC","Randomization":{"Type":"None"},"RecodeValues":{"1":"0","2":"1"},"Selector":"SAVR","SubSelector":"TX","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON"}},"VariableNaming":{"1":"Male","2":"Female"}}},{"SurveyID":"SV_erphejWdpLjnNpI","Element":"SQ","PrimaryAttribute":"QID668","SecondaryAttribute":"Information sheet Invitation to our study We would like to invite you to participate in this rese...","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong>Information sheet<br>\n<br>\nInvitation to our study<\/strong><br>\nWe would like to invite you to participate in this research project. You should only participate if you want to; choosing not to take part will not disadvantage you in any way. Before you decide whether you want to take part, it is important for you to read the following information carefully and discuss it with others, if you wish.&nbsp;<br>\n<br>\n<strong>The study<\/strong><br>\nThis study aims to estimate how long people take to read verbal problems with comprehension. You will also be asked to provide basic information about yourself.&nbsp;This online study consists of one session, lasts maximum 5 minutes and is paid \u00a30.50.<br>\n<br>\n<strong>Potential risks<\/strong><br>\nThere are no known risks attached to participating in this experiment.<br>\n<br>\n<strong>Informed consent<\/strong><br>\nShould you agree to take part in this experiment, you will be asked to confirm your informed consent before the experiment commences.<br>\n<br>\n<strong>Withdrawal<\/strong><br>\nYour participation is voluntary, and you will be free to withdraw from the project at any time without giving any reason and without penalty. If you wish to withdraw, you simply need to close the browser with the questionnaire. It will not be possible to withdraw from the study after you have completed it because we will not be able to identify your data.<br>\n<br>\n<strong>Data gathered<\/strong><br>\nYour experimental data will be fully anonymous, so that it is not possible to identify you from our stored data. Your data will be gathered by Prof Miroslav Sirota.&nbsp;Your anonymous data may be published in scientific journal articles, and shared in permanent, publicly accessible archives accessible from any country.<\/p>\n<br>\n<strong>Ethical approval<\/strong><br>\nThis project has been reviewed on behalf of the University of Essex Ethics Committee and had been given approval.\n<br><br><p><strong>Concerns and complaints<\/strong><br>\nIf you have any concerns about any aspect of the study or you have a complaint, in the first instance please contact the Principal Investigator of the project (see contact details below). If you are still concerned or you think your complaint has not been addressed to your satisfaction, please contact the Director of Research in the Principal Investigator\u2019s department (see below). If you are still not satisfied, please contact the <span style=\"line-height:115%\"><span style=\"line-height:115%\">University\u2019s Research Integrity Manager (see below)<\/span><\/span>.<br>\n<br>\n<strong>Contact details<\/strong><\/p>\n\n<p><strong>Principal Investigator<\/strong><\/p>\n\n<p>Prof Miroslav Sirota<br>\nEmail: msirota@essex.ac.uk<br><br><\/p>\n\n<p><span style=\"line-height:115%\"><strong><span style=\"line-height:115%\">Director of Research, Dept of Psychology<\/span><\/strong><br>\n<span style=\"line-height:115%\">Prof Sheina Orbell (<\/span><a href=\"mailto:sorbell@essex.ac.uk\" style=\"color:blue; text-decoration:underline\"><span style=\"line-height:115%\">sorbell@essex.ac.uk<\/span><\/a><span style=\"line-height:115%\"> )<br>\n<br>\n<b>University of Essex Research Integrity Manager<\/b><\/span><\/span><br>\n<span style=\"line-height:115%\"><span style=\"line-height:115%\">Mantalena Sotiriadou, Research &amp; Enterprise Office, University of Essex, Wivenhoe Park, CO4 3SQ, Colchester. <\/span><\/span><br>\n<span style=\"line-height:115%\"><span style=\"line-height:115%\">Email: <\/span><a href=\"mailto:ms21994@essex.ac.uk\" style=\"color:blue; text-decoration:underline\"><span style=\"line-height:115%\">ms21994@essex.ac.uk<\/span><\/a><span style=\"line-height:115%\"> .&nbsp; Phone: 01206-873561<\/span><\/span><\/p>","DefaultChoices":false,"DataExportTag":"InfoSheet","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Information sheet Invitation to our study We would like to invite you to participate in this rese...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionID":"QID668"}},{"SurveyID":"SV_erphejWdpLjnNpI","Element":"SQ","PrimaryAttribute":"QID957","SecondaryAttribute":"Marc has \u00a310 in his pocket. Marc gives \u00a35 to his friend, Tom. How much money does Marc have left..","TertiaryAttribute":null,"Payload":{"QuestionText":"Marc has \u00a310 in his pocket. Marc gives \u00a35 to his friend, Tom. How much money does Marc have left in his pocket?","DefaultChoices":false,"DataExportTag":"Pp1_a","QuestionID":"QID957","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Marc has \u00a310 in his pocket. Marc gives \u00a35 to his friend, Tom. How much money does Marc have left...","Choices":{"4":{"Display":"Option A"},"5":{"Display":"Option B"},"6":{"Display":"Option C"},"7":{"Display":"Option D"}},"ChoiceOrder":["4","5","6","7"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":8,"NextAnswerId":1,"Randomization":{"Advanced":null,"Type":"All","TotalRandSubset":""}}},{"SurveyID":"SV_erphejWdpLjnNpI","Element":"SQ","PrimaryAttribute":"QID1048","SecondaryAttribute":"Marie used a strong yeast for making bread dough. In a large bowl, a dough ball doubles in size e...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div>Marie used a strong yeast for making bread dough. In a large bowl, a dough ball doubles in size every hour. Marie left the dough for 24 hours and it filled the bowl completely.<br>\n<br>\nIf she only wanted half the bowl filled, how long should she leave the dough?<\/div>","DefaultChoices":false,"QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Marie used a strong yeast for making bread dough. In a large bowl, a dough ball doubles in size e...","Choices":{"1":{"Display":"Option A"},"2":{"Display":"Option B"},"3":{"Display":"Option C"},"4":{"Display":"Option D"}},"ChoiceOrder":["1","2","3","4"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"},"QuestionText_Unsafe":"<div>A car factory in Dongguan has 100 new industrial robot arms that can manufacture 100 self-driving cars in 100 minutes.<\/div><div><br><\/div><div>How many minutes must 200 industrial robots take to manufacture 200 self-driving cars?\n<\/div>","DataExportTag":"CRT5_a","QuestionID":"QID1048"}},{"SurveyID":"SV_erphejWdpLjnNpI","Element":"SQ","PrimaryAttribute":"QID1069","SecondaryAttribute":"Ok. This is the end of practice. Click the \"Next\" button if you are ready to start.","TertiaryAttribute":null,"Payload":{"QuestionText":"Ok. This is the end of practice.<br><br>Click the \"Next\" button if you are ready to start.","DefaultChoices":false,"DataExportTag":"Q92","QuestionID":"QID1069","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Ok. This is the end of practice. Click the \"Next\" button if you are ready to start.","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_erphejWdpLjnNpI","Element":"SQ","PrimaryAttribute":"QID1057","SecondaryAttribute":"Peter has \u00a312 in his pocket. Peter gives \u00a37 to his friend, Timothy. How much money does Peter hav.","TertiaryAttribute":null,"Payload":{"QuestionText":"Peter has \u00a312 in his pocket. Peter gives \u00a37 to his friend, Timothy. How much money does Peter have left in his pocket?","DefaultChoices":false,"QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Peter has \u00a312 in his pocket. Peter gives \u00a37 to his friend, Timothy. How much money does Peter hav...","Choices":{"4":{"Display":"Option A"},"5":{"Display":"Option B"},"6":{"Display":"Option C"},"7":{"Display":"Option D"}},"ChoiceOrder":["4","5","6","7"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":8,"NextAnswerId":1,"QuestionText_Unsafe":"If you have only one match and you walk into a dark room where there is \nan oil lamp, a newspaper and wood \u2013 which thing would you light first?","DataExportTag":"Pp2_a","QuestionID":"QID1057"}},{"SurveyID":"SV_erphejWdpLjnNpI","Element":"SQ","PrimaryAttribute":"QID681","SecondaryAttribute":"Please click NEXT to submit the data.","TertiaryAttribute":null,"Payload":{"QuestionText":"Please click NEXT to submit the data.","DefaultChoices":false,"DataExportTag":"Submit","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Please click NEXT to submit the data.","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":1,"NextAnswerId":1,"QuestionID":"QID681"}},{"SurveyID":"SV_erphejWdpLjnNpI","Element":"SQ","PrimaryAttribute":"QID852","SecondaryAttribute":"Please read these instructions carefully! In this part, you will see one practice problem and six...","TertiaryAttribute":null,"Payload":{"QuestionText":"<em>Please read these instructions carefully!<\/em><br>\n<br>\nIn this part, you will see one practice problem and six test problems we plan to use in future studies.<strong> Your task is pretty simple: you just need to read these problems and select \"Option A\" as an answer to these problems.<\/strong> We want to know how long people need on average to read the material and select one of the answer options. <strong>Do not try to solve or think about the problems. Just read the problem, choose \"Option A\", and advance to the next problem.<\/strong><br>\n<br>\n<em><strong>Please stay focused and read the problems in the way you typically would. Since we want to get an accurate reading time estimate, please avoid getting distracted before you finish reading.<\/strong><\/em><br>\n<br>\nPlease confirm below that you have read these instructions carefully and then press the \u201cNext\u201d button.<br>\n&nbsp;","DefaultChoices":false,"DataExportTag":"Instr","QuestionID":"QID852","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Please read these instructions carefully! In this part, you will see one practice problem and six...","Choices":{"1":{"Display":"I read the instructions carefully"}},"ChoiceOrder":["1"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_erphejWdpLjnNpI","Element":"SQ","PrimaryAttribute":"QID863","SecondaryAttribute":"Please select the term that was mentioned in the problem you have just read.","TertiaryAttribute":null,"Payload":{"QuestionText":"Please select the term that was mentioned in the problem you have just read.","DataExportTag":"CRT1_ch","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Please select the term that was mentioned in the problem you have just read.","Choices":{"1":{"Display":"Summer"},"4":{"Display":"Beach"},"5":{"Display":"Ice cream"},"6":{"Display":"Spoon"}},"ChoiceOrder":["1","4","5","6"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":7,"NextAnswerId":1,"QuestionID":"QID863","Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"},"RecodeValues":{"1":"1","4":"2","5":"3","6":"4"}}},{"SurveyID":"SV_erphejWdpLjnNpI","Element":"SQ","PrimaryAttribute":"QID958","SecondaryAttribute":"Please select the term that was mentioned in the problem you have just read.","TertiaryAttribute":null,"Payload":{"QuestionText":"Please select the term that was mentioned in the problem you have just read.","DataExportTag":"Pp1_check","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Please select the term that was mentioned in the problem you have just read.","Choices":{"1":{"Display":"Marc"},"2":{"Display":"Jakob"},"3":{"Display":"Billy"},"4":{"Display":"Sam"}},"ChoiceOrder":["1","2","3","4"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID958","Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"},"DataVisibility":{"Private":false,"Hidden":false},"RecodeValues":{"1":"1","2":"2","3":"3","4":"4"}}},{"SurveyID":"SV_erphejWdpLjnNpI","Element":"SQ","PrimaryAttribute":"QID1037","SecondaryAttribute":"Please select the term that was mentioned in the problem you have just read.","TertiaryAttribute":null,"Payload":{"QuestionText":"Please select the term that was mentioned in the problem you have just read.","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Please select the term that was mentioned in the problem you have just read.","Choices":{"1":{"Display":"car race"},"4":{"Display":"running race"},"5":{"Display":"sledge race"},"6":{"Display":"yacht race"}},"ChoiceOrder":["1","4","5","6"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":7,"NextAnswerId":1,"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"},"QuestionText_Unsafe":"Please select the term that was mentioned in the problem you have just read.","DataExportTag":"CRT2_ch","QuestionID":"QID1037","RecodeValues":{"1":"1","4":"2","5":"3","6":"4"}}},{"SurveyID":"SV_erphejWdpLjnNpI","Element":"SQ","PrimaryAttribute":"QID1041","SecondaryAttribute":"Please select the term that was mentioned in the problem you have just read.","TertiaryAttribute":null,"Payload":{"QuestionText":"Please select the term that was mentioned in the problem you have just read.","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Please select the term that was mentioned in the problem you have just read.","Choices":{"1":{"Display":"runners"},"4":{"Display":"skiers"},"5":{"Display":"skaters"},"6":{"Display":"sailors"}},"ChoiceOrder":["1","4","5","6"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":7,"NextA